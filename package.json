{
  "name": "meo-skia-canvas",
  "version": "5.6.5",
  "description": "A multi-threaded, GPU-accelerated 2D graphics environment for Node: the HTML Canvas API on Skia, with GUI windows, animation, and export to raster and vector formats",
  "author": "L A Romeo <ukasyahrz@outlook.com>",
  "license": "MIT",
  "homepage": "https://github.com/l7aromeo/meo-skia-canvas",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/l7aromeo/meo-skia-canvas.git"
  },
  "bugs": {
    "url": "https://github.com/l7aromeo/meo-skia-canvas/issues"
  },
  "main": "./lib/index.js",
  "exports": {
    "node": {
      "import": "./lib/index.mjs",
      "require": "./lib/index.js"
    },
    "browser": {
      "types": "./lib/browser.d.ts",
      "default": "./lib/browser.js"
    },
    "types": "./lib/index.d.ts"
  },
  "types": "./lib/index.d.ts",
  "scripts": {
    "build": "node lib/prebuild.mjs compile",
    "install": "node lib/prebuild.mjs download --or-compile",
    "upload": "node lib/prebuild.mjs upload",
    "snapshot": "node lib/prebuild.mjs snapshot",
    "test": "node --test",
    "test:static": "node --test \"tests/static/*.test.js\"",
    "test:suite": "node --test \"tests/suite/*.test.js\"",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "sync-targets": "node scripts/platform-package.mjs sync",
    "typecheck": "tsc --project tsconfig.json"
  },
  "dependencies": {
    "detect-libc": "^2.1.1",
    "follow-redirects": "^1.15.11",
    "https-proxy-agent": "^9.1.0",
    "string-split-by": "^1.0.0"
  },
  "peerDependencies": {
    "sharp": ">=0.33.0"
  },
  "peerDependenciesMeta": {
    "sharp": {
      "optional": true
    }
  },
  "devDependencies": {
    "@hono/node-server": "^2.1.0",
    "@types/node": "^26.1.2",
    "cargo-cp-artifact": "^0.1",
    "hono": "^4.9.8",
    "nock": "^14.0.10",
    "prettier": "^3.9.6",
    "sharp": "^0.35.3",
    "tmp": "^0.2.5",
    "typescript": "^7.0.2"
  },
  "files": [
    "lib/*js",
    "lib/*ts",
    "lib/classes/*js",
    "lib/fonts",
    "lib/*.json"
  ],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "keywords": [
    "canvas",
    "gpu",
    "skia",
    "offscreen",
    "headless",
    "graphic",
    "graphics",
    "image",
    "images",
    "compositing",
    "render",
    "vulkan",
    "metal",
    "pdf",
    "svg",
    "rust"
  ],
  "prebuild": {
    "aws-lambda-arm64.zip": "sha256:ecedc9b194fc5726bfec08b1f08b2831be2af89063b45b41c18240632f65d0d7",
    "aws-lambda-x64.zip": "sha256:7cd0172ed12de45380446f01e47b1caa9a7cb82580e272d23cdfb4e81502112d",
    "darwin-arm64.gz": "sha256:c487043bdf64679b26033199ccd5ce3ad71d0041dcb1602d37337f016d18238a",
    "linux-arm64-glibc.gz": "sha256:9a06f14a606703c8f4f5014b188e75fefe709aac1498b56da36feaf8a543a56c",
    "linux-arm64-musl.gz": "sha256:b7b807e39bf8f0205ec33e4df1bf861e38a747e79f22d43859be250f9c14ca09",
    "linux-x64-glibc.gz": "sha256:1eba3a0c44d3a804132575186d6019098743584d6a510062d5bae1f08627c2e7",
    "linux-x64-musl.gz": "sha256:6183725bc06efa0a0457c1a145f95504ccd09be2f15318df849d20f9b20d49f5",
    "win32-arm64.gz": "sha256:4636fc7b231ab88335c343e27e489c9c0dbc5d5560dd0cfb381fddabe50434d7",
    "win32-x64.gz": "sha256:bc18d3fce7f72175087c3570ec6bc170b12a575b1bcb76ba90d4117e0edc6c5c"
  },
  "contributors": [
    "Christian Swinehart <drafting@samizdat.co>"
  ],
  "optionalDependencies": {
    "meo-skia-canvas-darwin-arm64": "5.6.5",
    "meo-skia-canvas-linux-x64-glibc": "5.6.5",
    "meo-skia-canvas-linux-x64-musl": "5.6.5",
    "meo-skia-canvas-linux-arm64-glibc": "5.6.5",
    "meo-skia-canvas-linux-arm64-musl": "5.6.5",
    "meo-skia-canvas-win32-x64": "5.6.5",
    "meo-skia-canvas-win32-arm64": "5.6.5"
  }
}
