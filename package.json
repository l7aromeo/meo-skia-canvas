{
  "name": "meo-skia-canvas",
  "version": "5.9.0",
  "description": "A multi-threaded, GPU-accelerated 2D graphics environment for Node: the HTML Canvas API on Skia, with GUI windows, animation, and export to raster and vector formats",
  "author": "L A Romeo <ukasyahrz@outlook.com>",
  "license": "MIT",
  "homepage": "https://github.com/l7aromeo/meo-skia-canvas",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/l7aromeo/meo-skia-canvas.git"
  },
  "bugs": {
    "url": "https://github.com/l7aromeo/meo-skia-canvas/issues"
  },
  "main": "./lib/index.js",
  "exports": {
    "node": {
      "import": "./lib/index.mjs",
      "require": "./lib/index.js"
    },
    "browser": {
      "types": "./lib/browser.d.ts",
      "default": "./lib/browser.js"
    },
    "types": "./lib/index.d.ts"
  },
  "types": "./lib/index.d.ts",
  "scripts": {
    "build": "node lib/prebuild.mjs compile",
    "install": "node lib/prebuild.mjs download --or-compile",
    "upload": "node lib/prebuild.mjs upload",
    "snapshot": "node lib/prebuild.mjs snapshot",
    "test": "node --test",
    "test:static": "node --test \"tests/static/*.test.js\"",
    "test:suite": "node --test \"tests/suite/*.test.js\"",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "sync-targets": "node scripts/platform-package.mjs sync",
    "typecheck": "tsc --project tsconfig.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "dependencies": {
    "detect-libc": "^2.1.1",
    "follow-redirects": "^1.15.11",
    "https-proxy-agent": "^9.1.0",
    "string-split-by": "^1.0.0"
  },
  "peerDependencies": {
    "sharp": ">=0.33.0"
  },
  "peerDependenciesMeta": {
    "sharp": {
      "optional": true
    }
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@hono/node-server": "^2.1.0",
    "@types/node": "^26.4.1",
    "cargo-cp-artifact": "^0.1",
    "eslint": "^10.10.0",
    "globals": "^17.12.0",
    "hono": "^4.9.8",
    "nock": "^14.0.10",
    "prettier": "^3.9.6",
    "sharp": "^0.35.3",
    "tmp": "^0.2.5",
    "typescript": "^7.0.2"
  },
  "files": [
    "lib/*js",
    "lib/*ts",
    "lib/classes/*js",
    "lib/fonts",
    "lib/*.json"
  ],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "keywords": [
    "canvas",
    "gpu",
    "skia",
    "offscreen",
    "headless",
    "graphic",
    "graphics",
    "image",
    "images",
    "compositing",
    "render",
    "vulkan",
    "metal",
    "pdf",
    "svg",
    "rust"
  ],
  "prebuild": {
    "aws-lambda-arm64.zip": "sha256:4479310fdfa8ad83943ec55362bfb1a45586d4bd73921f4587c07cbd40a58a22",
    "aws-lambda-x64.zip": "sha256:fa1cd95590fafc5b601657eb75e16d2659f7188c2cc52ba012ce923c68d6cb02",
    "darwin-arm64.gz": "sha256:4d4deba2a7cc30f3e581a01b08f47bfe34ddca056c05e323a94571648cf22f83",
    "linux-arm64-glibc.gz": "sha256:29cc59c784261f58a24122255ed4b74db1e7d443628f192764af631ccb62764a",
    "linux-arm64-musl.gz": "sha256:321880c6fd83763581cda2ad02ef7bbf3f0e1204bd41d663196afb04c1796d08",
    "linux-x64-glibc.gz": "sha256:48c26cb6a72beff84d344f6247a22114cd66b8cb3d3348543c260cbfc032ad63",
    "linux-x64-musl.gz": "sha256:33342ba87f19dc7358a74154dd3356c8eb32cd74b01d5aacbabef257a6d38094",
    "win32-arm64.gz": "sha256:aa0c1b0ccb9dc52f73fe350ba4e2a3e48853d0e59b3b5ba9a02a42e3d31998e7",
    "win32-x64.gz": "sha256:5bdf7354b307a338fed1dba4cbe9a3718ef236da485acb0ce8207e27b2074cb8"
  },
  "contributors": [
    "Christian Swinehart <drafting@samizdat.co>"
  ]
}
