{
  "name": "meo-skia-canvas",
  "version": "5.6.1",
  "description": "A multi-threaded, GPU-accelerated 2D graphics environment for Node: the HTML Canvas API on Skia, with GUI windows, animation, and export to raster and vector formats",
  "author": "L A Romeo <ukasyahrz@outlook.com>",
  "license": "MIT",
  "homepage": "https://github.com/l7aromeo/meo-skia-canvas",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/l7aromeo/meo-skia-canvas.git"
  },
  "bugs": {
    "url": "https://github.com/l7aromeo/meo-skia-canvas/issues"
  },
  "main": "./lib/index.js",
  "exports": {
    "node": {
      "import": "./lib/index.mjs",
      "require": "./lib/index.js"
    },
    "browser": {
      "types": "./lib/browser.d.ts",
      "default": "./lib/browser.js"
    },
    "types": "./lib/index.d.ts"
  },
  "types": "./lib/index.d.ts",
  "scripts": {
    "build": "node lib/prebuild.mjs compile",
    "install": "node lib/prebuild.mjs download --or-compile",
    "upload": "node lib/prebuild.mjs upload",
    "snapshot": "node lib/prebuild.mjs snapshot",
    "test": "node --test",
    "test:static": "node --test \"tests/static/*.test.js\"",
    "test:suite": "node --test \"tests/suite/*.test.js\"",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "sync-targets": "node scripts/platform-package.mjs sync",
    "typecheck": "tsc --project tsconfig.json"
  },
  "dependencies": {
    "detect-libc": "^2.1.1",
    "follow-redirects": "^1.15.11",
    "https-proxy-agent": "^9.1.0",
    "string-split-by": "^1.0.0"
  },
  "peerDependencies": {
    "sharp": ">=0.33.0"
  },
  "peerDependenciesMeta": {
    "sharp": {
      "optional": true
    }
  },
  "devDependencies": {
    "@hono/node-server": "^2.1.0",
    "@types/node": "^26.1.2",
    "cargo-cp-artifact": "^0.1",
    "hono": "^4.9.8",
    "nock": "^14.0.10",
    "prettier": "^3.9.6",
    "sharp": "^0.35.3",
    "tmp": "^0.2.5",
    "typescript": "^7.0.2"
  },
  "files": [
    "lib/*js",
    "lib/*ts",
    "lib/classes/*js",
    "lib/fonts",
    "lib/*.json"
  ],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "keywords": [
    "canvas",
    "gpu",
    "skia",
    "offscreen",
    "headless",
    "graphic",
    "graphics",
    "image",
    "images",
    "compositing",
    "render",
    "vulkan",
    "metal",
    "pdf",
    "svg",
    "rust"
  ],
  "prebuild": {
    "aws-lambda-arm64.zip": "sha256:4e25d892d8ceb296ed084301316b78d4cee047937db3a72d87c5c6348dabd2e4",
    "aws-lambda-x64.zip": "sha256:94c89db0543671cf6ddb7d43c9929a2261faf3f9cfc349347b2b0629c167d4f6",
    "darwin-arm64.gz": "sha256:21a79e267019cc393beae3d6162fd221fb7d13f9e1db6460976b5f83412140ed",
    "linux-arm64-glibc.gz": "sha256:ee7098cddd85085d1b85a5359c036db5baf0fd38d529a4e8b8d25a30ca4b21e0",
    "linux-arm64-musl.gz": "sha256:1127b0894a65f24058c5838ae68aeab1ddd011630527bba47e5725f868e20dab",
    "linux-x64-glibc.gz": "sha256:282085b35c30e24eb413468ffa0be965f3d3eeb75ebe88ee8f41c23ba110e3f8",
    "linux-x64-musl.gz": "sha256:1b610782b7b7e6cc1d33babdb98aef490be6c4e4152a0630fb11841cc84a9829",
    "win32-arm64.gz": "sha256:a87e90cb611138f8175133dab901e333d82616aff3cb47ba35f8378873007482",
    "win32-x64.gz": "sha256:b7ab638cd65b92851d4ae7aaf37826249c63c255b75ef73e848612f7777765fb"
  },
  "contributors": [
    "Christian Swinehart <drafting@samizdat.co>"
  ],
  "optionalDependencies": {
    "meo-skia-canvas-darwin-arm64": "5.6.1",
    "meo-skia-canvas-linux-x64-glibc": "5.6.1",
    "meo-skia-canvas-linux-x64-musl": "5.6.1",
    "meo-skia-canvas-linux-arm64-glibc": "5.6.1",
    "meo-skia-canvas-linux-arm64-musl": "5.6.1",
    "meo-skia-canvas-win32-x64": "5.6.1",
    "meo-skia-canvas-win32-arm64": "5.6.1"
  }
}
