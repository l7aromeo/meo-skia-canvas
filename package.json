{
  "name": "meo-skia-canvas",
  "version": "5.4.0",
  "description": "A multi-threaded, GPU-accelerated 2D graphics environment for Node: the HTML Canvas API on Skia, with GUI windows, animation, and twelve export formats",
  "author": "L A Romeo <ukasyahrz@outlook.com>",
  "license": "MIT",
  "homepage": "https://github.com/l7aromeo/meo-skia-canvas",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/l7aromeo/meo-skia-canvas.git"
  },
  "bugs": {
    "url": "https://github.com/l7aromeo/meo-skia-canvas/issues"
  },
  "main": "./lib/index.js",
  "exports": {
    "node": {
      "import": "./lib/index.mjs",
      "require": "./lib/index.js"
    },
    "browser": {
      "types": "./lib/browser.d.ts",
      "default": "./lib/browser.js"
    },
    "types": "./lib/index.d.ts"
  },
  "types": "./lib/index.d.ts",
  "scripts": {
    "build": "node lib/prebuild.mjs compile",
    "install": "node lib/prebuild.mjs download --or-compile",
    "upload": "node lib/prebuild.mjs upload",
    "snapshot": "node lib/prebuild.mjs snapshot",
    "test": "node --test",
    "test:static": "node --test \"tests/static/*.test.js\"",
    "test:suite": "node --test \"tests/suite/*.test.js\"",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "sync-targets": "node scripts/platform-package.mjs sync",
    "typecheck": "tsc --project tsconfig.json"
  },
  "dependencies": {
    "detect-libc": "^2.1.1",
    "follow-redirects": "^1.15.11",
    "https-proxy-agent": "^9.1.0",
    "string-split-by": "^1.0.0"
  },
  "peerDependencies": {
    "sharp": ">=0.33.0"
  },
  "peerDependenciesMeta": {
    "sharp": {
      "optional": true
    }
  },
  "devDependencies": {
    "@hono/node-server": "^2.1.0",
    "@types/node": "^26.1.2",
    "cargo-cp-artifact": "^0.1",
    "hono": "^4.9.8",
    "nock": "^14.0.10",
    "prettier": "^3.9.6",
    "sharp": "^0.35.3",
    "tmp": "^0.2.5",
    "typescript": "^7.0.2"
  },
  "files": [
    "lib/*js",
    "lib/*ts",
    "lib/classes/*js",
    "lib/fonts",
    "lib/*.json"
  ],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "keywords": [
    "canvas",
    "gpu",
    "skia",
    "offscreen",
    "headless",
    "graphic",
    "graphics",
    "image",
    "images",
    "compositing",
    "render",
    "vulkan",
    "metal",
    "pdf",
    "svg",
    "rust"
  ],
  "prebuild": {
    "aws-lambda-arm64.zip": "sha256:dd8cb2048255683721b8a9f2233f316b937d1f7e86f3620c1031de0c9d14b3fe",
    "aws-lambda-x64.zip": "sha256:e68a8a007db5cf06e24fa4af470aa568e869d31618afbcc5d708e925a29ebc4f",
    "darwin-arm64.gz": "sha256:01d700a88509294378c3411c26a9f1949979a84c58346249054b5cb719a3380b",
    "linux-arm64-glibc.gz": "sha256:ba37c7b42433daae815442526200170e4497180458ad2724de008901624d12bc",
    "linux-arm64-musl.gz": "sha256:d3307a6b78e8efe3d710c9ac16cc7d781112cbc1e36dd7038ed5fbc3c84083b9",
    "linux-x64-glibc.gz": "sha256:f927c3c46f6b6045dfb67dc1618a93af232e1c7b2fd54813e5a33bfa5262f717",
    "linux-x64-musl.gz": "sha256:a3992a4a70307ae427c52193c7299f5a545a973fd5f2730de55e7e91a5b8e7b5",
    "win32-arm64.gz": "sha256:96da3293c79d76946c5f0544d43b703d7be1f47e5d3269e8642e52e23e3b9843",
    "win32-x64.gz": "sha256:587d4f780b97a24119310202664549186dea4db142acb7a1f89e45f3304fb876"
  },
  "contributors": [
    "Christian Swinehart <drafting@samizdat.co>"
  ]
}
