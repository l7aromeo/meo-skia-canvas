{
  "name": "meo-skia-canvas",
  "version": "5.6.4",
  "description": "A multi-threaded, GPU-accelerated 2D graphics environment for Node: the HTML Canvas API on Skia, with GUI windows, animation, and export to raster and vector formats",
  "author": "L A Romeo <ukasyahrz@outlook.com>",
  "license": "MIT",
  "homepage": "https://github.com/l7aromeo/meo-skia-canvas",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/l7aromeo/meo-skia-canvas.git"
  },
  "bugs": {
    "url": "https://github.com/l7aromeo/meo-skia-canvas/issues"
  },
  "main": "./lib/index.js",
  "exports": {
    "node": {
      "import": "./lib/index.mjs",
      "require": "./lib/index.js"
    },
    "browser": {
      "types": "./lib/browser.d.ts",
      "default": "./lib/browser.js"
    },
    "types": "./lib/index.d.ts"
  },
  "types": "./lib/index.d.ts",
  "scripts": {
    "build": "node lib/prebuild.mjs compile",
    "install": "node lib/prebuild.mjs download --or-compile",
    "upload": "node lib/prebuild.mjs upload",
    "snapshot": "node lib/prebuild.mjs snapshot",
    "test": "node --test",
    "test:static": "node --test \"tests/static/*.test.js\"",
    "test:suite": "node --test \"tests/suite/*.test.js\"",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "sync-targets": "node scripts/platform-package.mjs sync",
    "typecheck": "tsc --project tsconfig.json"
  },
  "dependencies": {
    "detect-libc": "^2.1.1",
    "follow-redirects": "^1.15.11",
    "https-proxy-agent": "^9.1.0",
    "string-split-by": "^1.0.0"
  },
  "peerDependencies": {
    "sharp": ">=0.33.0"
  },
  "peerDependenciesMeta": {
    "sharp": {
      "optional": true
    }
  },
  "devDependencies": {
    "@hono/node-server": "^2.1.0",
    "@types/node": "^26.1.2",
    "cargo-cp-artifact": "^0.1",
    "hono": "^4.9.8",
    "nock": "^14.0.10",
    "prettier": "^3.9.6",
    "sharp": "^0.35.3",
    "tmp": "^0.2.5",
    "typescript": "^7.0.2"
  },
  "files": [
    "lib/*js",
    "lib/*ts",
    "lib/classes/*js",
    "lib/fonts",
    "lib/*.json"
  ],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "keywords": [
    "canvas",
    "gpu",
    "skia",
    "offscreen",
    "headless",
    "graphic",
    "graphics",
    "image",
    "images",
    "compositing",
    "render",
    "vulkan",
    "metal",
    "pdf",
    "svg",
    "rust"
  ],
  "prebuild": {
    "aws-lambda-arm64.zip": "sha256:af7786fe96a269a5ef350f6b5befecbc6479ea7f17f09ea0c882c976a2a9a6ab",
    "aws-lambda-x64.zip": "sha256:7e568d4e9f0b6e9e57dcf9d6425801aea59ea4f64b0b9b0fe06c16e804cf910b",
    "darwin-arm64.gz": "sha256:1997b6b74c28a2db0c059ba8e403f13e7409ccfa923eb3bbd375d6efe655b36c",
    "linux-arm64-glibc.gz": "sha256:a3017a923a687d58bda3bd310b5c9b4661b163cc957a5580fe4827f7be2770e2",
    "linux-arm64-musl.gz": "sha256:c0c42959159cd05704b43c076c4a4ca0d2037a0c057cae5400d1ff71d601ae69",
    "linux-x64-glibc.gz": "sha256:c5079ab09feee085bee9c1fec64200bff7c7adeabea3680e58f695bc21df5a44",
    "linux-x64-musl.gz": "sha256:7b5fbd024b935219d405276ee3766180a3a3306c14541d25b321709142f1814c",
    "win32-arm64.gz": "sha256:8833187a5aa75bcd41832330edda4e015d8eba1401de16d2aba83220516794c9",
    "win32-x64.gz": "sha256:00ba6a76fb349d0fd5749eee027945f019f21d23a95deb88c913078c132e1a15"
  },
  "contributors": [
    "Christian Swinehart <drafting@samizdat.co>"
  ]
}
