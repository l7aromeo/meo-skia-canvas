{
  "name": "meo-skia-canvas",
  "version": "5.5.0",
  "description": "A multi-threaded, GPU-accelerated 2D graphics environment for Node: the HTML Canvas API on Skia, with GUI windows, animation, and twelve export formats",
  "author": "L A Romeo <ukasyahrz@outlook.com>",
  "license": "MIT",
  "homepage": "https://github.com/l7aromeo/meo-skia-canvas",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/l7aromeo/meo-skia-canvas.git"
  },
  "bugs": {
    "url": "https://github.com/l7aromeo/meo-skia-canvas/issues"
  },
  "main": "./lib/index.js",
  "exports": {
    "node": {
      "import": "./lib/index.mjs",
      "require": "./lib/index.js"
    },
    "browser": {
      "types": "./lib/browser.d.ts",
      "default": "./lib/browser.js"
    },
    "types": "./lib/index.d.ts"
  },
  "types": "./lib/index.d.ts",
  "scripts": {
    "build": "node lib/prebuild.mjs compile",
    "install": "node lib/prebuild.mjs download --or-compile",
    "upload": "node lib/prebuild.mjs upload",
    "snapshot": "node lib/prebuild.mjs snapshot",
    "test": "node --test",
    "test:static": "node --test \"tests/static/*.test.js\"",
    "test:suite": "node --test \"tests/suite/*.test.js\"",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "sync-targets": "node scripts/platform-package.mjs sync",
    "typecheck": "tsc --project tsconfig.json"
  },
  "dependencies": {
    "detect-libc": "^2.1.1",
    "follow-redirects": "^1.15.11",
    "https-proxy-agent": "^9.1.0",
    "string-split-by": "^1.0.0"
  },
  "peerDependencies": {
    "sharp": ">=0.33.0"
  },
  "peerDependenciesMeta": {
    "sharp": {
      "optional": true
    }
  },
  "devDependencies": {
    "@hono/node-server": "^2.1.0",
    "@types/node": "^26.1.2",
    "cargo-cp-artifact": "^0.1",
    "hono": "^4.9.8",
    "nock": "^14.0.10",
    "prettier": "^3.9.6",
    "sharp": "^0.35.3",
    "tmp": "^0.2.5",
    "typescript": "^7.0.2"
  },
  "files": [
    "lib/*js",
    "lib/*ts",
    "lib/classes/*js",
    "lib/fonts",
    "lib/*.json"
  ],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "keywords": [
    "canvas",
    "gpu",
    "skia",
    "offscreen",
    "headless",
    "graphic",
    "graphics",
    "image",
    "images",
    "compositing",
    "render",
    "vulkan",
    "metal",
    "pdf",
    "svg",
    "rust"
  ],
  "prebuild": {
    "aws-lambda-arm64.zip": "sha256:918083723330739db9d869a5fdfeb7eeec9ae8bd12737433c485a668e47b6bd6",
    "aws-lambda-x64.zip": "sha256:9bde27cf3b64080e94b08061764e133428e41715156f1382d07e545953120612",
    "darwin-arm64.gz": "sha256:68ba62adba62cbe303cf9b3b7528a0b6154039ce51d127665a3a20f85f123f25",
    "linux-arm64-glibc.gz": "sha256:1650c284a3894a90042d55dbeae5cbda109298c6a5481ddfe36b58ecb98d7d7e",
    "linux-arm64-musl.gz": "sha256:98cf86c15304a9821d3cfcebcf93e25fde1404e1d86b80d98b47dd5d43118cb3",
    "linux-x64-glibc.gz": "sha256:f4f63ab21affe939bbe7d472f424de9120b8323db85f2d5943345786b8224889",
    "linux-x64-musl.gz": "sha256:a89f4d5011a8afaeada362646fac0496f3a83daf9a35f07b8f9c9ebfb296dbc8",
    "win32-arm64.gz": "sha256:6cd72f8f473a62be92c740baeae701c0669fe1ecd12299ed0244c8a65cf24892",
    "win32-x64.gz": "sha256:4d169c7fcfc54dc89225738e09ab0b24ccd835ddf48e290faca33e019fcca1f1"
  },
  "contributors": [
    "Christian Swinehart <drafting@samizdat.co>"
  ],
  "optionalDependencies": {
    "meo-skia-canvas-darwin-arm64": "5.5.0",
    "meo-skia-canvas-linux-x64-glibc": "5.5.0",
    "meo-skia-canvas-linux-x64-musl": "5.5.0",
    "meo-skia-canvas-linux-arm64-glibc": "5.5.0",
    "meo-skia-canvas-linux-arm64-musl": "5.5.0",
    "meo-skia-canvas-win32-x64": "5.5.0",
    "meo-skia-canvas-win32-arm64": "5.5.0"
  }
}
