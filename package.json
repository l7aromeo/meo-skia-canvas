{
  "name": "meo-skia-canvas",
  "version": "5.4.0",
  "description": "A multi-threaded, GPU-accelerated 2D graphics environment for Node: the HTML Canvas API on Skia, with GUI windows, animation, and twelve export formats",
  "author": "L A Romeo <ukasyahrz@outlook.com>",
  "license": "MIT",
  "homepage": "https://github.com/l7aromeo/meo-skia-canvas",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/l7aromeo/meo-skia-canvas.git"
  },
  "bugs": {
    "url": "https://github.com/l7aromeo/meo-skia-canvas/issues"
  },
  "main": "./lib/index.js",
  "exports": {
    "node": {
      "import": "./lib/index.mjs",
      "require": "./lib/index.js"
    },
    "browser": {
      "types": "./lib/browser.d.ts",
      "default": "./lib/browser.js"
    },
    "types": "./lib/index.d.ts"
  },
  "types": "./lib/index.d.ts",
  "scripts": {
    "build": "node lib/prebuild.mjs compile",
    "install": "node lib/prebuild.mjs download --or-compile",
    "upload": "node lib/prebuild.mjs upload",
    "snapshot": "node lib/prebuild.mjs snapshot",
    "test": "node --test",
    "test:static": "node --test \"tests/static/*.test.js\"",
    "test:suite": "node --test \"tests/suite/*.test.js\"",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "sync-targets": "node scripts/platform-package.mjs sync",
    "typecheck": "tsc --project tsconfig.json"
  },
  "dependencies": {
    "detect-libc": "^2.1.1",
    "follow-redirects": "^1.15.11",
    "https-proxy-agent": "^9.1.0",
    "string-split-by": "^1.0.0"
  },
  "peerDependencies": {
    "sharp": ">=0.33.0"
  },
  "peerDependenciesMeta": {
    "sharp": {
      "optional": true
    }
  },
  "devDependencies": {
    "@hono/node-server": "^2.1.0",
    "@types/node": "^26.1.2",
    "cargo-cp-artifact": "^0.1",
    "hono": "^4.9.8",
    "nock": "^14.0.10",
    "prettier": "^3.9.6",
    "sharp": "^0.35.3",
    "tmp": "^0.2.5",
    "typescript": "^7.0.2"
  },
  "files": [
    "lib/*js",
    "lib/*ts",
    "lib/classes/*js",
    "lib/fonts",
    "lib/*.json"
  ],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "keywords": [
    "canvas",
    "gpu",
    "skia",
    "offscreen",
    "headless",
    "graphic",
    "graphics",
    "image",
    "images",
    "compositing",
    "render",
    "vulkan",
    "metal",
    "pdf",
    "svg",
    "rust"
  ],
  "prebuild": {
    "aws-lambda-arm64.zip": "sha256:a87fa1140421ed09234aab17ffe46586afed64163ca06d1d54d0c392f52806bf",
    "aws-lambda-x64.zip": "sha256:6f171c0d75e33606a6abea42b9d8c06b0687e7d7799e974e6b6645417523da51",
    "darwin-arm64.gz": "sha256:735d0853e16556e31cf721ad95975d6c1f93daccbaf15c907554816a3420c540",
    "linux-arm64-glibc.gz": "sha256:7c005e229c80d46f17483f556105732238fa56f0883eb845ea06ab993656456d",
    "linux-arm64-musl.gz": "sha256:152e26fe695b116bef9b5884b576c82ec6bda74631ea331c79e9ec465ead94de",
    "linux-x64-glibc.gz": "sha256:0ed7560e6853c98d0ed4e86754aad3017b71bb61c160edf670a769e6401bfccd",
    "linux-x64-musl.gz": "sha256:2db7dcb19064a75975daf42200967e65c956f3b918d4f6ccb6e9fdc963ed519e",
    "win32-arm64.gz": "sha256:481425cacd3f9bde68fb9e8849ddde8184e6a95bf5ec997bd4e08814b1769cae",
    "win32-x64.gz": "sha256:536c8154fd43f36e06cfb0af99aca3f3a7f90c2accefac81a59dcc781044807b"
  },
  "contributors": [
    "Christian Swinehart <drafting@samizdat.co>"
  ],
  "optionalDependencies": {
    "meo-skia-canvas-darwin-arm64": "5.4.0",
    "meo-skia-canvas-linux-x64-glibc": "5.4.0",
    "meo-skia-canvas-linux-x64-musl": "5.4.0",
    "meo-skia-canvas-linux-arm64-glibc": "5.4.0",
    "meo-skia-canvas-linux-arm64-musl": "5.4.0",
    "meo-skia-canvas-win32-x64": "5.4.0",
    "meo-skia-canvas-win32-arm64": "5.4.0"
  }
}
