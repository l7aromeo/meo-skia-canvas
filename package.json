{
  "name": "meo-skia-canvas",
  "version": "5.0.0",
  "description": "A multi-threaded, GPU-accelerated Canvas API for Node, forked from phyron-skia-canvas",
  "author": "L A Romeo <ukasyahrz@outlook.com>",
  "license": "MIT",
  "homepage": "https://github.com/l7aromeo/meo-skia-canvas",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/l7aromeo/meo-skia-canvas.git"
  },
  "bugs": {
    "url": "https://github.com/l7aromeo/meo-skia-canvas/issues"
  },
  "main": "./lib/index.js",
  "exports": {
    "node": {
      "import": "./lib/index.mjs",
      "require": "./lib/index.js"
    },
    "browser": {
      "types": "./lib/browser.d.ts",
      "default": "./lib/browser.js"
    },
    "types": "./lib/index.d.ts"
  },
  "types": "./lib/index.d.ts",
  "scripts": {
    "build": "node lib/prebuild.mjs compile",
    "install": "node lib/prebuild.mjs download --or-compile",
    "upload": "node lib/prebuild.mjs upload",
    "snapshot": "node lib/prebuild.mjs snapshot",
    "test": "node --test",
    "test:static": "node --test \"tests/static/*.test.js\"",
    "test:suite": "node --test \"tests/suite/*.test.js\"",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "sync-targets": "node scripts/platform-package.mjs sync",
    "typecheck": "tsc --project tsconfig.json"
  },
  "dependencies": {
    "detect-libc": "^2.1.1",
    "follow-redirects": "^1.15.11",
    "https-proxy-agent": "^9.1.0",
    "string-split-by": "^1.0.0"
  },
  "peerDependencies": {
    "sharp": ">=0.33.0"
  },
  "peerDependenciesMeta": {
    "sharp": {
      "optional": true
    }
  },
  "devDependencies": {
    "@hono/node-server": "^2.1.0",
    "@types/node": "^26.1.2",
    "cargo-cp-artifact": "^0.1",
    "hono": "^4.9.8",
    "nock": "^14.0.10",
    "prettier": "^3.9.6",
    "sharp": "^0.35.3",
    "tmp": "^0.2.5",
    "typescript": "^7.0.2"
  },
  "files": [
    "lib/*js",
    "lib/*ts",
    "lib/classes/*js",
    "lib/fonts",
    "lib/*.json"
  ],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "keywords": [
    "canvas",
    "gpu",
    "skia",
    "offscreen",
    "headless",
    "graphic",
    "graphics",
    "image",
    "images",
    "compositing",
    "render",
    "vulkan",
    "metal",
    "pdf",
    "svg",
    "rust"
  ],
  "prebuild": {
    "aws-lambda-arm64.zip": "sha256:5c83b2de43a1c28245c28ec27848ede7a894670906bd1de2ce0d301fe79deea5",
    "aws-lambda-x64.zip": "sha256:f79bdbcff9db7f3728621d2c57314ef29f6deab5e8c8402c0a44aadc3f7ca339",
    "darwin-arm64.gz": "sha256:a46eb14228ed167541fd85fca6fd61115700cb4c01a86fd6ea7114fb680f1f92",
    "linux-arm64-glibc.gz": "sha256:f1b7c27811c45d5db5489bea5ec3bd6c5fb4e6e9cdd094de616388f706078360",
    "linux-arm64-musl.gz": "sha256:a7c0ce2522070e0ee8df34906d648cb40103a72f8758f240e63eba413e2cbe41",
    "linux-x64-glibc.gz": "sha256:36378e4da0d07ce16e4c80e1b393fb18caf92802a4c95bc0f90faa85d5de66df",
    "linux-x64-musl.gz": "sha256:6080677cd17fc50095db746f6bad34ad870007a9f66e59dd42eddd989ab85d7a",
    "win32-arm64.gz": "sha256:8fa8d451c64b8460b202db52f25ef323efb337f543eda9b9dd3623f237781fd4",
    "win32-x64.gz": "sha256:2d690e477184db443ab19b8df71f2aceb84377c584c0002c8163105a83f13f7a"
  },
  "contributors": [
    "Christian Swinehart <drafting@samizdat.co>"
  ]
}
