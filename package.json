{
  "name": "meo-skia-canvas",
  "version": "6.0.2",
  "description": "A multi-threaded, GPU-accelerated 2D graphics environment for Node: the HTML Canvas API on Skia, with GUI windows, animation, and export to raster and vector formats",
  "author": "L A Romeo <ukasyahrz@outlook.com>",
  "license": "MIT",
  "homepage": "https://github.com/l7aromeo/meo-skia-canvas",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/l7aromeo/meo-skia-canvas.git"
  },
  "bugs": {
    "url": "https://github.com/l7aromeo/meo-skia-canvas/issues"
  },
  "main": "./lib/index.js",
  "exports": {
    "node": {
      "import": "./lib/index.mjs",
      "require": "./lib/index.js"
    },
    "browser": {
      "types": "./lib/browser.d.ts",
      "default": "./lib/browser.js"
    },
    "types": "./lib/index.d.ts"
  },
  "types": "./lib/index.d.ts",
  "scripts": {
    "build": "node lib/prebuild.mjs compile",
    "install": "node lib/prebuild.mjs download --or-compile",
    "upload": "node lib/prebuild.mjs upload",
    "snapshot": "node lib/prebuild.mjs snapshot",
    "test": "node scripts/test.mjs",
    "test:static": "node scripts/test.mjs \"tests/static/*.test.js\"",
    "test:suite": "node scripts/test.mjs \"tests/suite/*.test.js\"",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "sync-targets": "node scripts/platform-package.mjs sync",
    "typecheck": "tsc --project tsconfig.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "dependencies": {
    "detect-libc": "^2.1.1",
    "follow-redirects": "^1.15.11",
    "https-proxy-agent": "^9.1.0",
    "string-split-by": "^1.0.0"
  },
  "peerDependencies": {
    "sharp": ">=0.33.0"
  },
  "peerDependenciesMeta": {
    "sharp": {
      "optional": true
    }
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@hono/node-server": "^2.1.0",
    "@types/node": "^26.4.1",
    "cargo-cp-artifact": "^0.1",
    "eslint": "^10.10.0",
    "globals": "^17.12.0",
    "hono": "^4.9.8",
    "nock": "^14.0.10",
    "prettier": "^3.9.6",
    "sharp": "^0.35.3",
    "tmp": "^0.2.5",
    "typescript": "^7.0.2",
    "yaml": "2.9.1"
  },
  "files": [
    "lib/*js",
    "lib/*ts",
    "lib/classes/*js",
    "lib/fonts",
    "lib/*.json",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "keywords": [
    "canvas",
    "gpu",
    "skia",
    "offscreen",
    "headless",
    "graphic",
    "graphics",
    "image",
    "images",
    "compositing",
    "render",
    "vulkan",
    "metal",
    "pdf",
    "svg",
    "rust"
  ],
  "prebuild": {
    "aws-lambda-arm64.zip": "sha256:792d81247aa8c873f2e38fcefd6339450789c3c3ec4cd2dc434bb133d5504b59",
    "aws-lambda-x64.zip": "sha256:ddde77a460df919ba6042b9553ac5e21fc982aea1f512901741d23733af84064",
    "darwin-arm64.gz": "sha256:eab9012a888ff241879a6011c06d3a8b1b964c6c740f964d98a503b64d69297a",
    "linux-arm64-glibc.gz": "sha256:fd2f3284b6cb93d783ec48dc2389c7629b5ac160efdc84bbfbaec47db1d8a1c3",
    "linux-arm64-musl.gz": "sha256:110c4f7519a8d9d58ea77c4ff5c6ef86ee0f0830f3230460b3b4848b3cda32de",
    "linux-x64-glibc.gz": "sha256:b164fc23fdcbbf1162d62c7a7150cfdfa5d63a3faabff3b87c0efc9893ec78c8",
    "linux-x64-musl.gz": "sha256:c9451bc8fe38764ddfa93878066c009dc505e04210ef2569cf20e8381124e7a8",
    "win32-arm64.gz": "sha256:c8f4142f8b0524fbab21fa9efc6b6d3716388642d58a4b29bf71a8407be860af",
    "win32-x64.gz": "sha256:2018a991617cfa74189472325b3b5f34cc279bd37a3fb0686023cd91228ccf07"
  },
  "contributors": [
    "Christian Swinehart <drafting@samizdat.co>"
  ]
}
