{
  "name": "meo-skia-canvas",
  "version": "7.1.0",
  "description": "A multi-threaded, GPU-accelerated 2D graphics environment for Node: the HTML Canvas API on Skia, with GUI windows, animation, and export to raster and vector formats",
  "author": "L A Romeo <ukasyahrz@outlook.com>",
  "license": "MIT",
  "homepage": "https://github.com/l7aromeo/meo-skia-canvas",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/l7aromeo/meo-skia-canvas.git"
  },
  "bugs": {
    "url": "https://github.com/l7aromeo/meo-skia-canvas/issues"
  },
  "main": "./lib/index.js",
  "exports": {
    "node": {
      "import": "./lib/index.mjs",
      "require": "./lib/index.js"
    },
    "browser": {
      "types": "./lib/browser.d.ts",
      "default": "./lib/browser.js"
    },
    "types": "./lib/index.d.ts"
  },
  "types": "./lib/index.d.ts",
  "scripts": {
    "build": "node lib/prebuild.mjs compile",
    "install": "node lib/prebuild.mjs download --or-compile",
    "upload": "node lib/prebuild.mjs upload",
    "snapshot": "node lib/prebuild.mjs snapshot",
    "test": "node scripts/test.mjs",
    "test:static": "node scripts/test.mjs \"tests/static/*.test.js\"",
    "test:suite": "node scripts/test.mjs \"tests/suite/*.test.js\"",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "sync-targets": "node scripts/platform-package.mjs sync",
    "typecheck": "tsc --project tsconfig.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "dependencies": {
    "detect-libc": "^2.1.2",
    "follow-redirects": "^1.16.1",
    "https-proxy-agent": "^9.1.0",
    "string-split-by": "^1.0.0"
  },
  "peerDependencies": {
    "sharp": ">=0.33.0"
  },
  "peerDependenciesMeta": {
    "sharp": {
      "optional": true
    }
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@hono/node-server": "^2.1.5",
    "@types/node": "^26.6.5",
    "cargo-cp-artifact": "^0.1.9",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "hono": "^4.13.13",
    "nock": "^15.0.5",
    "prettier": "^3.9.10",
    "sharp": "^0.35.5",
    "tmp": "^0.2.7",
    "typescript": "^7.0.2",
    "yaml": "2.9.1"
  },
  "files": [
    "lib/*js",
    "lib/*ts",
    "lib/classes/*js",
    "lib/*.json",
    "CHANGELOG.md",
    "THIRD-PARTY-NOTICES.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "keywords": [
    "canvas",
    "gpu",
    "skia",
    "offscreen",
    "headless",
    "graphic",
    "graphics",
    "image",
    "images",
    "compositing",
    "render",
    "vulkan",
    "metal",
    "pdf",
    "svg",
    "rust"
  ],
  "prebuild": {
    "aws-lambda-arm64.zip": "sha256:456b6dbeef2a6a70a6b90cf372336cb929fd17852d2aafda967f6761aed40200",
    "aws-lambda-x64.zip": "sha256:3f3f1381b9bc3c376e23c790a93cc8fe974931487bf02c368c4bf2cbeb2df9e6",
    "darwin-arm64.gz": "sha256:e4d17a8370ad3465a876c55d200665475443def57fbae1023d23f6b631c7f80e",
    "linux-arm64-glibc.gz": "sha256:102041b155481995e5533fe1fcebe1a741138083bb7ebca416ec8fce75c183c7",
    "linux-arm64-musl.gz": "sha256:3d8339ef7956a10d744faf72d702b30e186819037f67a9b3c37dfa03647a3b30",
    "linux-x64-glibc.gz": "sha256:3c137c88a8e223243af6b56a3bd55fe4f6a815d7774ded90a42e69a59d08e518",
    "linux-x64-musl.gz": "sha256:14781ad868d8fc6288d06b77070360d2c5ff3098db760e39341dbedc2e6ad072",
    "win32-arm64.gz": "sha256:a5c2b100ca789eb4bf7c4d061a581e0953093e35aa8b49883e17dc1c92205047",
    "win32-x64.gz": "sha256:5ea1183f43a58452aa44136c1de692847036deeb4dffc3f7e49e23a39794d4ec"
  },
  "contributors": [
    "Christian Swinehart <drafting@samizdat.co>"
  ],
  "optionalDependencies": {
    "meo-skia-canvas-darwin-arm64": "7.1.0",
    "meo-skia-canvas-linux-x64-glibc": "7.1.0",
    "meo-skia-canvas-linux-x64-musl": "7.1.0",
    "meo-skia-canvas-linux-arm64-glibc": "7.1.0",
    "meo-skia-canvas-linux-arm64-musl": "7.1.0",
    "meo-skia-canvas-win32-x64": "7.1.0",
    "meo-skia-canvas-win32-arm64": "7.1.0"
  }
}
