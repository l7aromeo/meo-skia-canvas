{
  "name": "meo-skia-canvas",
  "version": "6.0.0",
  "description": "A multi-threaded, GPU-accelerated 2D graphics environment for Node: the HTML Canvas API on Skia, with GUI windows, animation, and export to raster and vector formats",
  "author": "L A Romeo <ukasyahrz@outlook.com>",
  "license": "MIT",
  "homepage": "https://github.com/l7aromeo/meo-skia-canvas",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/l7aromeo/meo-skia-canvas.git"
  },
  "bugs": {
    "url": "https://github.com/l7aromeo/meo-skia-canvas/issues"
  },
  "main": "./lib/index.js",
  "exports": {
    "node": {
      "import": "./lib/index.mjs",
      "require": "./lib/index.js"
    },
    "browser": {
      "types": "./lib/browser.d.ts",
      "default": "./lib/browser.js"
    },
    "types": "./lib/index.d.ts"
  },
  "types": "./lib/index.d.ts",
  "scripts": {
    "build": "node lib/prebuild.mjs compile",
    "install": "node lib/prebuild.mjs download --or-compile",
    "upload": "node lib/prebuild.mjs upload",
    "snapshot": "node lib/prebuild.mjs snapshot",
    "test": "node scripts/test.mjs",
    "test:static": "node scripts/test.mjs \"tests/static/*.test.js\"",
    "test:suite": "node scripts/test.mjs \"tests/suite/*.test.js\"",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "sync-targets": "node scripts/platform-package.mjs sync",
    "typecheck": "tsc --project tsconfig.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "dependencies": {
    "detect-libc": "^2.1.1",
    "follow-redirects": "^1.15.11",
    "https-proxy-agent": "^9.1.0",
    "string-split-by": "^1.0.0"
  },
  "peerDependencies": {
    "sharp": ">=0.33.0"
  },
  "peerDependenciesMeta": {
    "sharp": {
      "optional": true
    }
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@hono/node-server": "^2.1.0",
    "@types/node": "^26.4.1",
    "cargo-cp-artifact": "^0.1",
    "eslint": "^10.10.0",
    "globals": "^17.12.0",
    "hono": "^4.9.8",
    "nock": "^14.0.10",
    "prettier": "^3.9.6",
    "sharp": "^0.35.3",
    "tmp": "^0.2.5",
    "typescript": "^7.0.2",
    "yaml": "2.9.0"
  },
  "files": [
    "lib/*js",
    "lib/*ts",
    "lib/classes/*js",
    "lib/fonts",
    "lib/*.json",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "keywords": [
    "canvas",
    "gpu",
    "skia",
    "offscreen",
    "headless",
    "graphic",
    "graphics",
    "image",
    "images",
    "compositing",
    "render",
    "vulkan",
    "metal",
    "pdf",
    "svg",
    "rust"
  ],
  "prebuild": {
    "aws-lambda-arm64.zip": "sha256:40d508ffbd3d49472f7add1849da87350b45e3692f2119381f3fea7aadb19ee3",
    "aws-lambda-x64.zip": "sha256:b51e969de442cb8c678f4898a37376367a5fb9ab44b8865ac360bf4b263078b8",
    "darwin-arm64.gz": "sha256:0ab075d19e3c3a8ee040f4459b676a675584ef52db8860e4b9abeca882898195",
    "linux-arm64-glibc.gz": "sha256:375da7e2f76e25aaa8e758bcaa0bd515a404bc96e34be8973fb65273cc8ea080",
    "linux-arm64-musl.gz": "sha256:657507efb727d4d2c70be3644e158cb0f898a14ab204bf8b621e2116a3ea26f9",
    "linux-x64-glibc.gz": "sha256:ec39b8a01db3bc139fa3f96b4c0ad2cf93fa312377a970c72ae637fc73dbf5b1",
    "linux-x64-musl.gz": "sha256:5275f5e62ee3cb4063bd6fd4bbc04d8ec6a1c059a1efda674f4930c0c90dc64f",
    "win32-arm64.gz": "sha256:3f354089a61ecfe37fd045d4a9845139dd728b6e8c34ae9906e9debad90c48af",
    "win32-x64.gz": "sha256:a97ccec6bf3a41ee51b837db213511f24ddac786391a3b94e1e12460ea5fdae1"
  },
  "contributors": [
    "Christian Swinehart <drafting@samizdat.co>"
  ],
  "optionalDependencies": {
    "meo-skia-canvas-darwin-arm64": "6.0.0",
    "meo-skia-canvas-linux-x64-glibc": "6.0.0",
    "meo-skia-canvas-linux-x64-musl": "6.0.0",
    "meo-skia-canvas-linux-arm64-glibc": "6.0.0",
    "meo-skia-canvas-linux-arm64-musl": "6.0.0",
    "meo-skia-canvas-win32-x64": "6.0.0",
    "meo-skia-canvas-win32-arm64": "6.0.0"
  }
}
