{
  "name": "meo-skia-canvas",
  "version": "5.8.0",
  "description": "A multi-threaded, GPU-accelerated 2D graphics environment for Node: the HTML Canvas API on Skia, with GUI windows, animation, and export to raster and vector formats",
  "author": "L A Romeo <ukasyahrz@outlook.com>",
  "license": "MIT",
  "homepage": "https://github.com/l7aromeo/meo-skia-canvas",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/l7aromeo/meo-skia-canvas.git"
  },
  "bugs": {
    "url": "https://github.com/l7aromeo/meo-skia-canvas/issues"
  },
  "main": "./lib/index.js",
  "exports": {
    "node": {
      "import": "./lib/index.mjs",
      "require": "./lib/index.js"
    },
    "browser": {
      "types": "./lib/browser.d.ts",
      "default": "./lib/browser.js"
    },
    "types": "./lib/index.d.ts"
  },
  "types": "./lib/index.d.ts",
  "scripts": {
    "build": "node lib/prebuild.mjs compile",
    "install": "node lib/prebuild.mjs download --or-compile",
    "upload": "node lib/prebuild.mjs upload",
    "snapshot": "node lib/prebuild.mjs snapshot",
    "test": "node --test",
    "test:static": "node --test \"tests/static/*.test.js\"",
    "test:suite": "node --test \"tests/suite/*.test.js\"",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "sync-targets": "node scripts/platform-package.mjs sync",
    "typecheck": "tsc --project tsconfig.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "dependencies": {
    "detect-libc": "^2.1.1",
    "follow-redirects": "^1.15.11",
    "https-proxy-agent": "^9.1.0",
    "string-split-by": "^1.0.0"
  },
  "peerDependencies": {
    "sharp": ">=0.33.0"
  },
  "peerDependenciesMeta": {
    "sharp": {
      "optional": true
    }
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@hono/node-server": "^2.1.0",
    "@types/node": "^26.4.1",
    "cargo-cp-artifact": "^0.1",
    "eslint": "^10.10.0",
    "globals": "^17.12.0",
    "hono": "^4.9.8",
    "nock": "^14.0.10",
    "prettier": "^3.9.6",
    "sharp": "^0.35.3",
    "tmp": "^0.2.5",
    "typescript": "^7.0.2"
  },
  "files": [
    "lib/*js",
    "lib/*ts",
    "lib/classes/*js",
    "lib/fonts",
    "lib/*.json"
  ],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "keywords": [
    "canvas",
    "gpu",
    "skia",
    "offscreen",
    "headless",
    "graphic",
    "graphics",
    "image",
    "images",
    "compositing",
    "render",
    "vulkan",
    "metal",
    "pdf",
    "svg",
    "rust"
  ],
  "prebuild": {
    "aws-lambda-arm64.zip": "sha256:ea7c292ba3e80481ad067791a8df6144cf1a66108b6607f5bd152bb560f57202",
    "aws-lambda-x64.zip": "sha256:1325b3be9a04b4810ace67a7f8556e7a98cc6c8a97423aa32d672a7712690749",
    "darwin-arm64.gz": "sha256:36ecf82fde202b1af0513bde744a6175f02436c4aa80ef8bc60c04e70bcf3c83",
    "linux-arm64-glibc.gz": "sha256:c590381814703c0980b85797b7787eefdf2a5faf1fb59805d4ea19f6f669597e",
    "linux-arm64-musl.gz": "sha256:7408a60019e39b909ab59d321f408e0c91c52a21476d3e25eb5405c2e1dac5ba",
    "linux-x64-glibc.gz": "sha256:903c52dbfee359309328bcb719e6106145a32fa1d946867d3aa6898b6c7b21f4",
    "linux-x64-musl.gz": "sha256:3ce95dc5897895874a4dce3c9fda00020ba7121c47d2413b7e0f6d4fb9ceb8a3",
    "win32-arm64.gz": "sha256:c374f53527a3fd65e34e55ead6eccd3b0f18bbbfb1933a0151ca65ba397dc4b7",
    "win32-x64.gz": "sha256:a0f87c4bb91bc8fd148212f3df5f1d848507ca67b45dc71ddfe3d4c0080c894f"
  },
  "contributors": [
    "Christian Swinehart <drafting@samizdat.co>"
  ]
}
