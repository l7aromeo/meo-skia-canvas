{
  "name": "meo-skia-canvas",
  "version": "6.0.1",
  "description": "A multi-threaded, GPU-accelerated 2D graphics environment for Node: the HTML Canvas API on Skia, with GUI windows, animation, and export to raster and vector formats",
  "author": "L A Romeo <ukasyahrz@outlook.com>",
  "license": "MIT",
  "homepage": "https://github.com/l7aromeo/meo-skia-canvas",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/l7aromeo/meo-skia-canvas.git"
  },
  "bugs": {
    "url": "https://github.com/l7aromeo/meo-skia-canvas/issues"
  },
  "main": "./lib/index.js",
  "exports": {
    "node": {
      "import": "./lib/index.mjs",
      "require": "./lib/index.js"
    },
    "browser": {
      "types": "./lib/browser.d.ts",
      "default": "./lib/browser.js"
    },
    "types": "./lib/index.d.ts"
  },
  "types": "./lib/index.d.ts",
  "scripts": {
    "build": "node lib/prebuild.mjs compile",
    "install": "node lib/prebuild.mjs download --or-compile",
    "upload": "node lib/prebuild.mjs upload",
    "snapshot": "node lib/prebuild.mjs snapshot",
    "test": "node scripts/test.mjs",
    "test:static": "node scripts/test.mjs \"tests/static/*.test.js\"",
    "test:suite": "node scripts/test.mjs \"tests/suite/*.test.js\"",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "sync-targets": "node scripts/platform-package.mjs sync",
    "typecheck": "tsc --project tsconfig.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "dependencies": {
    "detect-libc": "^2.1.1",
    "follow-redirects": "^1.15.11",
    "https-proxy-agent": "^9.1.0",
    "string-split-by": "^1.0.0"
  },
  "peerDependencies": {
    "sharp": ">=0.33.0"
  },
  "peerDependenciesMeta": {
    "sharp": {
      "optional": true
    }
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@hono/node-server": "^2.1.0",
    "@types/node": "^26.4.1",
    "cargo-cp-artifact": "^0.1",
    "eslint": "^10.10.0",
    "globals": "^17.12.0",
    "hono": "^4.9.8",
    "nock": "^14.0.10",
    "prettier": "^3.9.6",
    "sharp": "^0.35.3",
    "tmp": "^0.2.5",
    "typescript": "^7.0.2",
    "yaml": "2.9.1"
  },
  "files": [
    "lib/*js",
    "lib/*ts",
    "lib/classes/*js",
    "lib/fonts",
    "lib/*.json",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "keywords": [
    "canvas",
    "gpu",
    "skia",
    "offscreen",
    "headless",
    "graphic",
    "graphics",
    "image",
    "images",
    "compositing",
    "render",
    "vulkan",
    "metal",
    "pdf",
    "svg",
    "rust"
  ],
  "prebuild": {
    "aws-lambda-arm64.zip": "sha256:6198f15ad65d23d3e02267ab95733401b129959d987566b3c8d7538b01b73262",
    "aws-lambda-x64.zip": "sha256:719cc95fb335200cc9faaa336605b8b7ec1ac2b66368c71b21f03a1b33550492",
    "darwin-arm64.gz": "sha256:bf767852f0b18cacdb2a0c65a82fa4bca27538ba107b1e8ff17e7fa5ccb30265",
    "linux-arm64-glibc.gz": "sha256:9a853f711970d9dfb8b6e1a46e0f8d43b7693b76b309ce9ab4da74540e51d14b",
    "linux-arm64-musl.gz": "sha256:d4ceeb20375156a49f19bc8d013fc4e665dd5ed30f60c69f69fb881d24aafb4c",
    "linux-x64-glibc.gz": "sha256:fd778e73a855ce0b832b3224d4910c862fdd5c76c69d8235e2e8d60ddee338a6",
    "linux-x64-musl.gz": "sha256:be52ae27f84df640177ae13291d7fe4bfe94e0e54c96863bb67a5f22fbbfcdef",
    "win32-arm64.gz": "sha256:6181256823f919d3e7290910d2ec96f6c2347e8a9f25cae6670fceb233ebb2a3",
    "win32-x64.gz": "sha256:0806a985d4f56e237f3dd38a330adf29a28e5d6cc5cb4c865e173b0eb0443dce"
  },
  "contributors": [
    "Christian Swinehart <drafting@samizdat.co>"
  ]
}
