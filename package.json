{
  "name": "meo-skia-canvas",
  "version": "7.0.2",
  "description": "A multi-threaded, GPU-accelerated 2D graphics environment for Node: the HTML Canvas API on Skia, with GUI windows, animation, and export to raster and vector formats",
  "author": "L A Romeo <ukasyahrz@outlook.com>",
  "license": "MIT",
  "homepage": "https://github.com/l7aromeo/meo-skia-canvas",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/l7aromeo/meo-skia-canvas.git"
  },
  "bugs": {
    "url": "https://github.com/l7aromeo/meo-skia-canvas/issues"
  },
  "main": "./lib/index.js",
  "exports": {
    "node": {
      "import": "./lib/index.mjs",
      "require": "./lib/index.js"
    },
    "browser": {
      "types": "./lib/browser.d.ts",
      "default": "./lib/browser.js"
    },
    "types": "./lib/index.d.ts"
  },
  "types": "./lib/index.d.ts",
  "scripts": {
    "build": "node lib/prebuild.mjs compile",
    "install": "node lib/prebuild.mjs download --or-compile",
    "upload": "node lib/prebuild.mjs upload",
    "snapshot": "node lib/prebuild.mjs snapshot",
    "test": "node scripts/test.mjs",
    "test:static": "node scripts/test.mjs \"tests/static/*.test.js\"",
    "test:suite": "node scripts/test.mjs \"tests/suite/*.test.js\"",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "sync-targets": "node scripts/platform-package.mjs sync",
    "typecheck": "tsc --project tsconfig.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "dependencies": {
    "detect-libc": "^2.1.2",
    "follow-redirects": "^1.16.1",
    "https-proxy-agent": "^9.1.0",
    "string-split-by": "^1.0.0"
  },
  "peerDependencies": {
    "sharp": ">=0.33.0"
  },
  "peerDependenciesMeta": {
    "sharp": {
      "optional": true
    }
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@hono/node-server": "^2.1.5",
    "@types/node": "^26.6.5",
    "cargo-cp-artifact": "^0.1.9",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "hono": "^4.13.13",
    "nock": "^15.0.5",
    "prettier": "^3.9.10",
    "sharp": "^0.35.5",
    "tmp": "^0.2.7",
    "typescript": "^7.0.2",
    "yaml": "2.9.1"
  },
  "files": [
    "lib/*js",
    "lib/*ts",
    "lib/classes/*js",
    "lib/*.json",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "keywords": [
    "canvas",
    "gpu",
    "skia",
    "offscreen",
    "headless",
    "graphic",
    "graphics",
    "image",
    "images",
    "compositing",
    "render",
    "vulkan",
    "metal",
    "pdf",
    "svg",
    "rust"
  ],
  "prebuild": {
    "aws-lambda-arm64.zip": "sha256:36bf1db20c0697be759175bb8ee69a6f880ab6643adfd7b8999e3a0827a301e7",
    "aws-lambda-x64.zip": "sha256:ceaa17193ecdaa47a36f8d7d6c832780110fa7f0ccd4ce308bd33931d7a11d46",
    "darwin-arm64.gz": "sha256:50f23672cefd351a5a99660903872848de2960bcb2b1d5faa3b64282f8d0c161",
    "linux-arm64-glibc.gz": "sha256:8b402024c0db2b65b8dd3ff692bf3614b7290022d4bd0cbffb2ec7643abab0e2",
    "linux-arm64-musl.gz": "sha256:9928e759d044fae21ff7cdc2c755a1c8f630898d1e029cada41ae3d555f4dd48",
    "linux-x64-glibc.gz": "sha256:41882e70ab172b4450050ef68e86c47ad7705fafd158c46afd13be4406c7c1cb",
    "linux-x64-musl.gz": "sha256:3a0ee804eef516f6024761e389bda044553ba3f6e43834fc98b94684a4e4480d",
    "win32-arm64.gz": "sha256:a1748ee60598a821d44559afd2f53557fe8d43c149defed1d9be1f612098f509",
    "win32-x64.gz": "sha256:5f59b95729a9390e195610cd348c1128b1a21b77df06d6fe2ae8973cab529212"
  },
  "contributors": [
    "Christian Swinehart <drafting@samizdat.co>"
  ],
  "optionalDependencies": {
    "meo-skia-canvas-darwin-arm64": "7.0.2",
    "meo-skia-canvas-linux-x64-glibc": "7.0.2",
    "meo-skia-canvas-linux-x64-musl": "7.0.2",
    "meo-skia-canvas-linux-arm64-glibc": "7.0.2",
    "meo-skia-canvas-linux-arm64-musl": "7.0.2",
    "meo-skia-canvas-win32-x64": "7.0.2",
    "meo-skia-canvas-win32-arm64": "7.0.2"
  }
}
