{
  "name": "meo-skia-canvas",
  "version": "4.2.0-rc.2",
  "description": "A multi-threaded, GPU-accelerated Canvas API for Node, forked from phyron-skia-canvas",
  "author": "L A Romeo <ukasyahrz@outlook.com>",
  "license": "MIT",
  "homepage": "https://github.com/l7aromeo/meo-skia-canvas",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/l7aromeo/meo-skia-canvas.git"
  },
  "bugs": {
    "url": "https://github.com/l7aromeo/meo-skia-canvas/issues"
  },
  "main": "./lib/index.js",
  "exports": {
    "node": {
      "import": "./lib/index.mjs",
      "require": "./lib/index.js"
    },
    "browser": {
      "types": "./lib/browser.d.ts",
      "default": "./lib/browser.js"
    },
    "types": "./lib/index.d.ts"
  },
  "types": "./lib/index.d.ts",
  "scripts": {
    "build": "node lib/prebuild.mjs compile",
    "install": "node lib/prebuild.mjs download --or-compile",
    "upload": "node lib/prebuild.mjs upload",
    "snapshot": "node lib/prebuild.mjs snapshot",
    "test": "node --test",
    "test:static": "node --test \"tests/static/*.test.js\"",
    "test:suite": "node --test \"tests/suite/*.test.js\"",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "sync-targets": "node scripts/platform-package.mjs sync",
    "typecheck": "tsc --project tsconfig.json"
  },
  "dependencies": {
    "detect-libc": "^2.1.1",
    "follow-redirects": "^1.15.11",
    "https-proxy-agent": "^9.1.0",
    "string-split-by": "^1.0.0"
  },
  "peerDependencies": {
    "sharp": ">=0.33.0"
  },
  "peerDependenciesMeta": {
    "sharp": {
      "optional": true
    }
  },
  "devDependencies": {
    "@hono/node-server": "^2.1.0",
    "@types/node": "^26.1.2",
    "cargo-cp-artifact": "^0.1",
    "hono": "^4.9.8",
    "nock": "^14.0.10",
    "prettier": "^3.9.6",
    "sharp": "^0.35.3",
    "tmp": "^0.2.5",
    "typescript": "^7.0.2"
  },
  "files": [
    "lib/*js",
    "lib/*ts",
    "lib/classes/*js",
    "lib/fonts",
    "lib/*.json"
  ],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "keywords": [
    "canvas",
    "gpu",
    "skia",
    "offscreen",
    "headless",
    "graphic",
    "graphics",
    "image",
    "images",
    "compositing",
    "render",
    "vulkan",
    "metal",
    "pdf",
    "svg",
    "rust"
  ],
  "prebuild": {
    "aws-lambda-arm64.zip": "sha256:1eb68903f63bbc18576dc9bd59010d8a0ec1311783f9635af2ec5f11a223b194",
    "aws-lambda-x64.zip": "sha256:e4286559cb907ee4b0507d0eb3f09bf7d9b638509bd000931733fb2e5ed79035",
    "darwin-arm64.gz": "sha256:b650e46da6061d859f013832c8b000982b72e41991b016ec9dd4930d2f026e03",
    "linux-arm64-glibc.gz": "sha256:f32d145c2d6fd940b8c5869e6bda0d43e0ca01bbc9aafbbe0f02b54dff456507",
    "linux-arm64-musl.gz": "sha256:3c196a49148eefccae87b497a9ae0d9f44f4dae2ecf5ca847a81e1e1ae9637a7",
    "linux-x64-glibc.gz": "sha256:7b8d5597245378006c713f3d187e90c4310633db72622939a6fb10cf20a08413",
    "linux-x64-musl.gz": "sha256:5162126aff3708da07f2f5003fe4caa35b30d48aea0a1562109863e01160da4a",
    "win32-arm64.gz": "sha256:3295807aaa5f212a14296fdedc8873e6ab315ba064b9a05c09ffe27cea89bb22",
    "win32-x64.gz": "sha256:f5fc24824744a86f52c5ac6ebfef7da7d0bff0cf1f5f2d8c606d1535b43d2479"
  },
  "contributors": [
    "Christian Swinehart <drafting@samizdat.co>"
  ],
  "optionalDependencies": {
    "meo-skia-canvas-darwin-arm64": "4.2.0-rc.2",
    "meo-skia-canvas-linux-x64-glibc": "4.2.0-rc.2",
    "meo-skia-canvas-linux-x64-musl": "4.2.0-rc.2",
    "meo-skia-canvas-linux-arm64-glibc": "4.2.0-rc.2",
    "meo-skia-canvas-linux-arm64-musl": "4.2.0-rc.2",
    "meo-skia-canvas-win32-x64": "4.2.0-rc.2",
    "meo-skia-canvas-win32-arm64": "4.2.0-rc.2"
  }
}
