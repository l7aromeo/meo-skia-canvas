    "linux-arm64-musl.gz": "sha256:02d0be38ee385d5fdc3fbeb0aa1f101299bdd0ee591b367a195677b4e1dfd8e9",
    "linux-x64-glibc.gz": "sha256:7ddd122c3a75aeffd44fbe73814106753ef2d7e14b0f6b6160b4551c95d3eaaf",
    "linux-x64-musl.gz": "sha256:78547084aa0145d516ae0108c7073aa773d98df1ca292c0abeaa237ad8c852af",
    "win32-arm64.gz": "sha256:81bee449c4c5a5bd8b191e665c2701d5fef4930264d79fe951fe9ed132fd2195",
