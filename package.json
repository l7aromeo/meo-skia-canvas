{
  "name": "meo-skia-canvas",
  "version": "7.0.1",
  "description": "A multi-threaded, GPU-accelerated 2D graphics environment for Node: the HTML Canvas API on Skia, with GUI windows, animation, and export to raster and vector formats",
  "author": "L A Romeo <ukasyahrz@outlook.com>",
  "license": "MIT",
  "homepage": "https://github.com/l7aromeo/meo-skia-canvas",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/l7aromeo/meo-skia-canvas.git"
  },
  "bugs": {
    "url": "https://github.com/l7aromeo/meo-skia-canvas/issues"
  },
  "main": "./lib/index.js",
  "exports": {
    "node": {
      "import": "./lib/index.mjs",
      "require": "./lib/index.js"
    },
    "browser": {
      "types": "./lib/browser.d.ts",
      "default": "./lib/browser.js"
    },
    "types": "./lib/index.d.ts"
  },
  "types": "./lib/index.d.ts",
  "scripts": {
    "build": "node lib/prebuild.mjs compile",
    "install": "node lib/prebuild.mjs download --or-compile",
    "upload": "node lib/prebuild.mjs upload",
    "snapshot": "node lib/prebuild.mjs snapshot",
    "test": "node scripts/test.mjs",
    "test:static": "node scripts/test.mjs \"tests/static/*.test.js\"",
    "test:suite": "node scripts/test.mjs \"tests/suite/*.test.js\"",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "sync-targets": "node scripts/platform-package.mjs sync",
    "typecheck": "tsc --project tsconfig.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "dependencies": {
    "detect-libc": "^2.1.2",
    "follow-redirects": "^1.16.1",
    "https-proxy-agent": "^9.1.0",
    "string-split-by": "^1.0.0"
  },
  "peerDependencies": {
    "sharp": ">=0.33.0"
  },
  "peerDependenciesMeta": {
    "sharp": {
      "optional": true
    }
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@hono/node-server": "^2.1.5",
    "@types/node": "^26.6.5",
    "cargo-cp-artifact": "^0.1.9",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "hono": "^4.13.13",
    "nock": "^15.0.5",
    "prettier": "^3.9.10",
    "sharp": "^0.35.5",
    "tmp": "^0.2.7",
    "typescript": "^7.0.2",
    "yaml": "2.9.1"
  },
  "files": [
    "lib/*js",
    "lib/*ts",
    "lib/classes/*js",
    "lib/*.json",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "keywords": [
    "canvas",
    "gpu",
    "skia",
    "offscreen",
    "headless",
    "graphic",
    "graphics",
    "image",
    "images",
    "compositing",
    "render",
    "vulkan",
    "metal",
    "pdf",
    "svg",
    "rust"
  ],
  "prebuild": {
    "aws-lambda-arm64.zip": "sha256:44736ddb31d03e6b87584e5fa093eb7dd89338496c5ba50e34bc762876b6779e",
    "aws-lambda-x64.zip": "sha256:8322752348ada060af5a391f67df9af18be2b5ac100ff2864f07080d6b6f4a9c",
    "darwin-arm64.gz": "sha256:7a7045e9af62a79ad36b99c6e634d2f5bbade63eda3bbf3bb30764b2e95a4b2a",
    "linux-arm64-glibc.gz": "sha256:51f1dc1a3d9e215ed6be98fbb5593a739376d30708634443d198dae1d9301109",
    "linux-arm64-musl.gz": "sha256:0927e0cf5c48c10c5724bc5431cacd041f40df45652bae3da7555959ee8b7b91",
    "linux-x64-glibc.gz": "sha256:9bbc874ea33579b73fff27460e09665e6feea955043a8e4a5c87123391ac1e16",
    "linux-x64-musl.gz": "sha256:49dc34a51b38c1baddbc69ed2d5080ec439660f520a5930d187227a2e4dcdd16",
    "win32-arm64.gz": "sha256:91c8b138e70000d031cca76d6461e98f2266b5cbbe5391f8c705b1584b68960f",
    "win32-x64.gz": "sha256:6b71028993075d8d25cd80e68319aae14d6b546c42ad992017456b87d5feb48e"
  },
  "contributors": [
    "Christian Swinehart <drafting@samizdat.co>"
  ]
}
