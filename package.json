{
  "name": "meo-skia-canvas",
  "version": "5.6.0",
  "description": "A multi-threaded, GPU-accelerated 2D graphics environment for Node: the HTML Canvas API on Skia, with GUI windows, animation, and export to raster and vector formats",
  "author": "L A Romeo <ukasyahrz@outlook.com>",
  "license": "MIT",
  "homepage": "https://github.com/l7aromeo/meo-skia-canvas",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/l7aromeo/meo-skia-canvas.git"
  },
  "bugs": {
    "url": "https://github.com/l7aromeo/meo-skia-canvas/issues"
  },
  "main": "./lib/index.js",
  "exports": {
    "node": {
      "import": "./lib/index.mjs",
      "require": "./lib/index.js"
    },
    "browser": {
      "types": "./lib/browser.d.ts",
      "default": "./lib/browser.js"
    },
    "types": "./lib/index.d.ts"
  },
  "types": "./lib/index.d.ts",
  "scripts": {
    "build": "node lib/prebuild.mjs compile",
    "install": "node lib/prebuild.mjs download --or-compile",
    "upload": "node lib/prebuild.mjs upload",
    "snapshot": "node lib/prebuild.mjs snapshot",
    "test": "node --test",
    "test:static": "node --test \"tests/static/*.test.js\"",
    "test:suite": "node --test \"tests/suite/*.test.js\"",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "sync-targets": "node scripts/platform-package.mjs sync",
    "typecheck": "tsc --project tsconfig.json"
  },
  "dependencies": {
    "detect-libc": "^2.1.1",
    "follow-redirects": "^1.15.11",
    "https-proxy-agent": "^9.1.0",
    "string-split-by": "^1.0.0"
  },
  "peerDependencies": {
    "sharp": ">=0.33.0"
  },
  "peerDependenciesMeta": {
    "sharp": {
      "optional": true
    }
  },
  "devDependencies": {
    "@hono/node-server": "^2.1.0",
    "@types/node": "^26.1.2",
    "cargo-cp-artifact": "^0.1",
    "hono": "^4.9.8",
    "nock": "^14.0.10",
    "prettier": "^3.9.6",
    "sharp": "^0.35.3",
    "tmp": "^0.2.5",
    "typescript": "^7.0.2"
  },
  "files": [
    "lib/*js",
    "lib/*ts",
    "lib/classes/*js",
    "lib/fonts",
    "lib/*.json"
  ],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "keywords": [
    "canvas",
    "gpu",
    "skia",
    "offscreen",
    "headless",
    "graphic",
    "graphics",
    "image",
    "images",
    "compositing",
    "render",
    "vulkan",
    "metal",
    "pdf",
    "svg",
    "rust"
  ],
  "prebuild": {
    "aws-lambda-arm64.zip": "sha256:0ec99a7e79fb0f72aa3fc79423feb992cb6e7762cc1b503918eee66f9673f0ce",
    "aws-lambda-x64.zip": "sha256:0a02799d6d5f33d01c91f610e2ab42f0f4ec6b14fd92ea23fca00db238af7c28",
    "darwin-arm64.gz": "sha256:0b17a8eda6dfb0bb825fd97e9bd8bc7f7080f04ab9f7e81a7780d047a18a8007",
    "linux-arm64-glibc.gz": "sha256:de761931f5dbde277fa68df0d534ab50c5a61efd053bd61a71222fdbe52929dd",
    "linux-arm64-musl.gz": "sha256:080a22d6fec2492b99b02470ac3f904e6b62aac787468c31d62358e990247b02",
    "linux-x64-glibc.gz": "sha256:2224e2444a7507a57a8bb89df31c031d6046769f2f74d69526fc9e3de0d0df60",
    "linux-x64-musl.gz": "sha256:18fc0664f48d1ea043bc4f6fc3bed39533dbb91102e044e879a0514de1d39ba1",
    "win32-arm64.gz": "sha256:eb01bfb28e251be43c3e74515161c9279dcd27cfaff4be1f0ac277f43a918821",
    "win32-x64.gz": "sha256:596474f92fc3020570e3737cdd9bc7938785294f89a9dd9b2815f7dfe2a01f4a"
  },
  "contributors": [
    "Christian Swinehart <drafting@samizdat.co>"
  ]
}
