{
  "name": "meo-skia-canvas",
  "version": "5.6.5",
  "description": "A multi-threaded, GPU-accelerated 2D graphics environment for Node: the HTML Canvas API on Skia, with GUI windows, animation, and export to raster and vector formats",
  "author": "L A Romeo <ukasyahrz@outlook.com>",
  "license": "MIT",
  "homepage": "https://github.com/l7aromeo/meo-skia-canvas",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/l7aromeo/meo-skia-canvas.git"
  },
  "bugs": {
    "url": "https://github.com/l7aromeo/meo-skia-canvas/issues"
  },
  "main": "./lib/index.js",
  "exports": {
    "node": {
      "import": "./lib/index.mjs",
      "require": "./lib/index.js"
    },
    "browser": {
      "types": "./lib/browser.d.ts",
      "default": "./lib/browser.js"
    },
    "types": "./lib/index.d.ts"
  },
  "types": "./lib/index.d.ts",
  "scripts": {
    "build": "node lib/prebuild.mjs compile",
    "install": "node lib/prebuild.mjs download --or-compile",
    "upload": "node lib/prebuild.mjs upload",
    "snapshot": "node lib/prebuild.mjs snapshot",
    "test": "node --test",
    "test:static": "node --test \"tests/static/*.test.js\"",
    "test:suite": "node --test \"tests/suite/*.test.js\"",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "sync-targets": "node scripts/platform-package.mjs sync",
    "typecheck": "tsc --project tsconfig.json"
  },
  "dependencies": {
    "detect-libc": "^2.1.1",
    "follow-redirects": "^1.15.11",
    "https-proxy-agent": "^9.1.0",
    "string-split-by": "^1.0.0"
  },
  "peerDependencies": {
    "sharp": ">=0.33.0"
  },
  "peerDependenciesMeta": {
    "sharp": {
      "optional": true
    }
  },
  "devDependencies": {
    "@hono/node-server": "^2.1.0",
    "@types/node": "^26.1.2",
    "cargo-cp-artifact": "^0.1",
    "hono": "^4.9.8",
    "nock": "^14.0.10",
    "prettier": "^3.9.6",
    "sharp": "^0.35.3",
    "tmp": "^0.2.5",
    "typescript": "^7.0.2"
  },
  "files": [
    "lib/*js",
    "lib/*ts",
    "lib/classes/*js",
    "lib/fonts",
    "lib/*.json"
  ],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "keywords": [
    "canvas",
    "gpu",
    "skia",
    "offscreen",
    "headless",
    "graphic",
    "graphics",
    "image",
    "images",
    "compositing",
    "render",
    "vulkan",
    "metal",
    "pdf",
    "svg",
    "rust"
  ],
  "prebuild": {
    "aws-lambda-arm64.zip": "sha256:f79e62d75866bc9ca579029dffd2b0f62e3dededa21de9229ce5f5820ed619b4",
    "aws-lambda-x64.zip": "sha256:ae5f277b9937ef0efa3c9a79d45c63ccd12f9b2ca21d7d1fa5aeb66858fd9f26",
    "darwin-arm64.gz": "sha256:7bc08da3df4f45cbdc9a15486a2a98f79ac492e2de2a5813f3865a7598d32939",
    "linux-arm64-glibc.gz": "sha256:3ca60a65888b79a3b9f0d902a0a97becf6ce4b2274befd01c3f349529b454c8c",
    "linux-arm64-musl.gz": "sha256:a8fe06cd7456c1e2181d91e38a9200ae751e779d6a25900abee32d29730d119d",
    "linux-x64-glibc.gz": "sha256:29784de63d0c22ae88918c30068f49c8473c7dd77cb81529c04339d597db9ce1",
    "linux-x64-musl.gz": "sha256:2feb7da823f8ddeae142ea0c24769a2ac7586af633fe5d53dd5f764ec5f286ed",
    "win32-arm64.gz": "sha256:baacff852c1f9cf2292c6e9487dca713675b2d4ae3bec7721dec220342c53c27",
    "win32-x64.gz": "sha256:dde42f97bb467b5e4140013f55e06f32ed35ee97608685073abaa90c7e442a8f"
  },
  "contributors": [
    "Christian Swinehart <drafting@samizdat.co>"
  ]
}
