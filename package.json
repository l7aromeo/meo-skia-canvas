{
  "name": "meo-skia-canvas",
  "version": "7.0.2",
  "description": "A multi-threaded, GPU-accelerated 2D graphics environment for Node: the HTML Canvas API on Skia, with GUI windows, animation, and export to raster and vector formats",
  "author": "L A Romeo <ukasyahrz@outlook.com>",
  "license": "MIT",
  "homepage": "https://github.com/l7aromeo/meo-skia-canvas",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/l7aromeo/meo-skia-canvas.git"
  },
  "bugs": {
    "url": "https://github.com/l7aromeo/meo-skia-canvas/issues"
  },
  "main": "./lib/index.js",
  "exports": {
    "node": {
      "import": "./lib/index.mjs",
      "require": "./lib/index.js"
    },
    "browser": {
      "types": "./lib/browser.d.ts",
      "default": "./lib/browser.js"
    },
    "types": "./lib/index.d.ts"
  },
  "types": "./lib/index.d.ts",
  "scripts": {
    "build": "node lib/prebuild.mjs compile",
    "install": "node lib/prebuild.mjs download --or-compile",
    "upload": "node lib/prebuild.mjs upload",
    "snapshot": "node lib/prebuild.mjs snapshot",
    "test": "node scripts/test.mjs",
    "test:static": "node scripts/test.mjs \"tests/static/*.test.js\"",
    "test:suite": "node scripts/test.mjs \"tests/suite/*.test.js\"",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "sync-targets": "node scripts/platform-package.mjs sync",
    "typecheck": "tsc --project tsconfig.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "dependencies": {
    "detect-libc": "^2.1.2",
    "follow-redirects": "^1.16.1",
    "https-proxy-agent": "^9.1.0",
    "string-split-by": "^1.0.0"
  },
  "peerDependencies": {
    "sharp": ">=0.33.0"
  },
  "peerDependenciesMeta": {
    "sharp": {
      "optional": true
    }
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@hono/node-server": "^2.1.5",
    "@types/node": "^26.6.5",
    "cargo-cp-artifact": "^0.1.9",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "hono": "^4.13.13",
    "nock": "^15.0.5",
    "prettier": "^3.9.10",
    "sharp": "^0.35.5",
    "tmp": "^0.2.7",
    "typescript": "^7.0.2",
    "yaml": "2.9.1"
  },
  "files": [
    "lib/*js",
    "lib/*ts",
    "lib/classes/*js",
    "lib/*.json",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "keywords": [
    "canvas",
    "gpu",
    "skia",
    "offscreen",
    "headless",
    "graphic",
    "graphics",
    "image",
    "images",
    "compositing",
    "render",
    "vulkan",
    "metal",
    "pdf",
    "svg",
    "rust"
  ],
  "prebuild": {
    "aws-lambda-arm64.zip": "sha256:4af9827a2c9e2098861990deb36bdc7bbf13fc090bbc29b0211f8dfbe7c5e086",
    "aws-lambda-x64.zip": "sha256:76f8076367041ab94c099127110477040615fc8a2dd3d2fd00abe880bfab0c6e",
    "darwin-arm64.gz": "sha256:417eb2c52b49c8962edb96f333601ea5719ac13bea3cc2ac5b64c8f217cb9e69",
    "linux-arm64-glibc.gz": "sha256:1a603403d7d19d816e5217e7547ffec7c86bdeb616c153088a98bbba524627ef",
    "linux-arm64-musl.gz": "sha256:d0a269a655f1aa5b9a933f43a143586a7660578aff136fcfb19db49346854046",
    "linux-x64-glibc.gz": "sha256:9c0bf0071fbf8c1d65835ddf0e0a117b711406c7b06c840f7ca2e9d807b675cb",
    "linux-x64-musl.gz": "sha256:d8dd71a99eca6c5e3bb7cdf204b0ab337f6ee6f5cb2bee2fc46bd38be2d93a86",
    "win32-arm64.gz": "sha256:aa466610394a5c82b811d4e4eeede1aee06463753cc9bf255064c835e4460271",
    "win32-x64.gz": "sha256:7defe3476298ecb7e7482bf3c04ecbc529bc3ade58f0c5b974b24e0a05b621f4"
  },
  "contributors": [
    "Christian Swinehart <drafting@samizdat.co>"
  ]
}
