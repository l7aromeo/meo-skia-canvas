{
  "name": "meo-skia-canvas",
  "version": "5.6.2",
  "description": "A multi-threaded, GPU-accelerated 2D graphics environment for Node: the HTML Canvas API on Skia, with GUI windows, animation, and export to raster and vector formats",
  "author": "L A Romeo <ukasyahrz@outlook.com>",
  "license": "MIT",
  "homepage": "https://github.com/l7aromeo/meo-skia-canvas",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/l7aromeo/meo-skia-canvas.git"
  },
  "bugs": {
    "url": "https://github.com/l7aromeo/meo-skia-canvas/issues"
  },
  "main": "./lib/index.js",
  "exports": {
    "node": {
      "import": "./lib/index.mjs",
      "require": "./lib/index.js"
    },
    "browser": {
      "types": "./lib/browser.d.ts",
      "default": "./lib/browser.js"
    },
    "types": "./lib/index.d.ts"
  },
  "types": "./lib/index.d.ts",
  "scripts": {
    "build": "node lib/prebuild.mjs compile",
    "install": "node lib/prebuild.mjs download --or-compile",
    "upload": "node lib/prebuild.mjs upload",
    "snapshot": "node lib/prebuild.mjs snapshot",
    "test": "node --test",
    "test:static": "node --test \"tests/static/*.test.js\"",
    "test:suite": "node --test \"tests/suite/*.test.js\"",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "sync-targets": "node scripts/platform-package.mjs sync",
    "typecheck": "tsc --project tsconfig.json"
  },
  "dependencies": {
    "detect-libc": "^2.1.1",
    "follow-redirects": "^1.15.11",
    "https-proxy-agent": "^9.1.0",
    "string-split-by": "^1.0.0"
  },
  "peerDependencies": {
    "sharp": ">=0.33.0"
  },
  "peerDependenciesMeta": {
    "sharp": {
      "optional": true
    }
  },
  "devDependencies": {
    "@hono/node-server": "^2.1.0",
    "@types/node": "^26.1.2",
    "cargo-cp-artifact": "^0.1",
    "hono": "^4.9.8",
    "nock": "^14.0.10",
    "prettier": "^3.9.6",
    "sharp": "^0.35.3",
    "tmp": "^0.2.5",
    "typescript": "^7.0.2"
  },
  "files": [
    "lib/*js",
    "lib/*ts",
    "lib/classes/*js",
    "lib/fonts",
    "lib/*.json"
  ],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "keywords": [
    "canvas",
    "gpu",
    "skia",
    "offscreen",
    "headless",
    "graphic",
    "graphics",
    "image",
    "images",
    "compositing",
    "render",
    "vulkan",
    "metal",
    "pdf",
    "svg",
    "rust"
  ],
  "prebuild": {
    "aws-lambda-arm64.zip": "sha256:816f0a34b803e9a55faa989b9bccd2813be84952db4d556c0d32ebde195b8cf1",
    "aws-lambda-x64.zip": "sha256:f6191b848ff2a03885739c8a75fb7bd6f7cb4d0a883348df56eb4553d75e5605",
    "darwin-arm64.gz": "sha256:011d2513baf66308384e5f435590f6b90cf9b4e73d7c28fb135f84d827d3f779",
    "linux-arm64-glibc.gz": "sha256:d56ffc2600751fe68ac0cf979d16ca7efc683ee743a19567fa87e7362bbbc0ec",
    "linux-arm64-musl.gz": "sha256:dc22bcd533c2de2c8d1a3433fad192c265c3232c9ac4086a59fde43300111fc2",
    "linux-x64-glibc.gz": "sha256:9b7dffec145424a983f710d5fe9f87467b43c0975218436d43dc6cead7087d81",
    "linux-x64-musl.gz": "sha256:8b22b921b98d21eb0eac8cc581d429bf59ffb09c7a37d74fa0d761930ce64857",
    "win32-arm64.gz": "sha256:3a2616da1040e183ff51e3d2982fb3346afeb715b60afd1cc1fb566167fcfd8b",
    "win32-x64.gz": "sha256:5466c728119b55cddcabdfd43d42602de0c4b2977f1f7bea9aac75733bda1f0b"
  },
  "contributors": [
    "Christian Swinehart <drafting@samizdat.co>"
  ]
}
