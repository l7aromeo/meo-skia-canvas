{
  "name": "meo-skia-canvas",
  "version": "4.1.1",
  "description": "A multi-threaded, GPU-accelerated Canvas API for Node, forked from phyron-skia-canvas",
  "author": "L A Romeo <ukasyahrz@outlook.com>",
  "license": "MIT",
  "homepage": "https://github.com/l7aromeo/meo-skia-canvas",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/l7aromeo/meo-skia-canvas.git"
  },
  "bugs": {
    "url": "https://github.com/l7aromeo/meo-skia-canvas/issues"
  },
  "main": "./lib/index.js",
  "exports": {
    "node": {
      "import": "./lib/index.mjs",
      "require": "./lib/index.js"
    },
    "browser": {
      "types": "./lib/browser.d.ts",
      "default": "./lib/browser.js"
    },
    "types": "./lib/index.d.ts"
  },
  "types": "./lib/index.d.ts",
  "scripts": {
    "build": "node lib/prebuild.mjs compile",
    "install": "node lib/prebuild.mjs download --or-compile",
    "upload": "node lib/prebuild.mjs upload",
    "snapshot": "node lib/prebuild.mjs snapshot",
    "test": "node --test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "sync-targets": "node scripts/platform-package.mjs sync"
  },
  "dependencies": {
    "detect-libc": "^2.1.1",
    "follow-redirects": "^1.15.11",
    "https-proxy-agent": "^9.1.0",
    "string-split-by": "^1.0.0"
  },
  "peerDependencies": {
    "sharp": ">=0.33.0"
  },
  "peerDependenciesMeta": {
    "sharp": {
      "optional": true
    }
  },
  "devDependencies": {
    "@hono/node-server": "^2.1.0",
    "@types/node": "^26.1.2",
    "cargo-cp-artifact": "^0.1",
    "hono": "^4.9.8",
    "nock": "^14.0.10",
    "prettier": "^3.9.6",
    "tmp": "^0.2.5"
  },
  "files": [
    "lib/*js",
    "lib/*ts",
    "lib/classes/*js",
    "lib/fonts",
    "lib/*.json"
  ],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "keywords": [
    "canvas",
    "gpu",
    "skia",
    "offscreen",
    "headless",
    "graphic",
    "graphics",
    "image",
    "images",
    "compositing",
    "render",
    "vulkan",
    "metal",
    "pdf",
    "svg",
    "rust"
  ],
  "prebuild": {
    "aws-lambda-arm64.zip": "sha256:1d9505208139a82e29dcefbaa871df91a1a44c1a3b01b2db7bffd916cbd62fab",
    "aws-lambda-x64.zip": "sha256:aa471065bef00695b4b24fdace07632448bfbddaa1401bedc913f768d92d2a4c",
    "darwin-arm64.gz": "sha256:1881078dae35cce67ded05b8ebaf7b9bcfce9cbbd8c0dab53024bb47931236d6",
    "linux-arm64-glibc.gz": "sha256:c6541300b727d4a73b06234b7ef8411c2d7cfb1a7666709470b6a226c44e497f",
    "linux-arm64-musl.gz": "sha256:46e15033274cdc5d677e8ef8e6a8cdf4ab0a0d7ea9977d7960beaf17bc2338e6",
    "linux-x64-glibc.gz": "sha256:0af20677b99065b14c5b882de8bf6e7007c164bee6a8ef8a06f3cf8003945321",
    "linux-x64-musl.gz": "sha256:1526ccf92f12413a826de6f857f431efc1c6a9e8320a44a90306cd2f31b95d12",
    "win32-arm64.gz": "sha256:97d6b7fd3e7764bbc07bbed3eb98eb480a95bf0ec060998626e68dab3a2cc70c",
    "win32-x64.gz": "sha256:ad2c4b05e5dc7935dd18910e1e4380de1ce99b77ba234798a0e112ad2e1965da"
  },
  "contributors": [
    "Christian Swinehart <drafting@samizdat.co>"
  ]
}
