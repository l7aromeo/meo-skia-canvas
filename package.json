{
  "name": "meo-skia-canvas",
  "version": "5.2.0",
  "description": "A multi-threaded, GPU-accelerated 2D graphics environment for Node: the HTML Canvas API on Skia, with GUI windows, animation, and twelve export formats",
  "author": "L A Romeo <ukasyahrz@outlook.com>",
  "license": "MIT",
  "homepage": "https://github.com/l7aromeo/meo-skia-canvas",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/l7aromeo/meo-skia-canvas.git"
  },
  "bugs": {
    "url": "https://github.com/l7aromeo/meo-skia-canvas/issues"
  },
  "main": "./lib/index.js",
  "exports": {
    "node": {
      "import": "./lib/index.mjs",
      "require": "./lib/index.js"
    },
    "browser": {
      "types": "./lib/browser.d.ts",
      "default": "./lib/browser.js"
    },
    "types": "./lib/index.d.ts"
  },
  "types": "./lib/index.d.ts",
  "scripts": {
    "build": "node lib/prebuild.mjs compile",
    "install": "node lib/prebuild.mjs download --or-compile",
    "upload": "node lib/prebuild.mjs upload",
    "snapshot": "node lib/prebuild.mjs snapshot",
    "test": "node --test",
    "test:static": "node --test \"tests/static/*.test.js\"",
    "test:suite": "node --test \"tests/suite/*.test.js\"",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "sync-targets": "node scripts/platform-package.mjs sync",
    "typecheck": "tsc --project tsconfig.json"
  },
  "dependencies": {
    "detect-libc": "^2.1.1",
    "follow-redirects": "^1.15.11",
    "https-proxy-agent": "^9.1.0",
    "string-split-by": "^1.0.0"
  },
  "peerDependencies": {
    "sharp": ">=0.33.0"
  },
  "peerDependenciesMeta": {
    "sharp": {
      "optional": true
    }
  },
  "devDependencies": {
    "@hono/node-server": "^2.1.0",
    "@types/node": "^26.1.2",
    "cargo-cp-artifact": "^0.1",
    "hono": "^4.9.8",
    "nock": "^14.0.10",
    "prettier": "^3.9.6",
    "sharp": "^0.35.3",
    "tmp": "^0.2.5",
    "typescript": "^7.0.2"
  },
  "files": [
    "lib/*js",
    "lib/*ts",
    "lib/classes/*js",
    "lib/fonts",
    "lib/*.json"
  ],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "keywords": [
    "canvas",
    "gpu",
    "skia",
    "offscreen",
    "headless",
    "graphic",
    "graphics",
    "image",
    "images",
    "compositing",
    "render",
    "vulkan",
    "metal",
    "pdf",
    "svg",
    "rust"
  ],
  "prebuild": {
    "aws-lambda-arm64.zip": "sha256:1c52b5257ce4f2ef391177bf03a90995e5d2caa74185a37e8e53b183d62dc907",
    "aws-lambda-x64.zip": "sha256:f9fc0c4c22698bf2789a55cf27971013da7eb4b28cbaecf6c60bbb46c6ec5e7a",
    "darwin-arm64.gz": "sha256:4508d027e6f62e7f56d86a08fe3005fc8cbbaa92e90070c7cfb85e68f8c27373",
    "linux-arm64-glibc.gz": "sha256:7cf210ee9298780b482da2b3452e48559918be7bdafcf660bb911a04f172d43a",
    "linux-arm64-musl.gz": "sha256:d8f3347aebc24dcab3221170cac636bfe068dd2f8bb9a3eb90112d58edd99d7c",
    "linux-x64-glibc.gz": "sha256:314b41a8b561846b632435c8daebb87fe5045ca96cd4f706e1582304c64f049a",
    "linux-x64-musl.gz": "sha256:9314168e47f6dbf59c3738cbddedee2bc481db291e008af4ed884cbe9ef0cf97",
    "win32-arm64.gz": "sha256:d687b07d8f3e7f40ad52d34d4dab3c68dccda0734b2c1bb6c41833bf7c858223",
    "win32-x64.gz": "sha256:db8064b995d388c729e640af5355e216b33a79d2d98b1cd3d14c1ea08a23f03d"
  },
  "contributors": [
    "Christian Swinehart <drafting@samizdat.co>"
  ]
}
