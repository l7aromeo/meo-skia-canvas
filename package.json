{
  "name": "meo-skia-canvas",
  "version": "4.2.0-rc.2",
  "description": "A multi-threaded, GPU-accelerated Canvas API for Node, forked from phyron-skia-canvas",
  "author": "L A Romeo <ukasyahrz@outlook.com>",
  "license": "MIT",
  "homepage": "https://github.com/l7aromeo/meo-skia-canvas",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/l7aromeo/meo-skia-canvas.git"
  },
  "bugs": {
    "url": "https://github.com/l7aromeo/meo-skia-canvas/issues"
  },
  "main": "./lib/index.js",
  "exports": {
    "node": {
      "import": "./lib/index.mjs",
      "require": "./lib/index.js"
    },
    "browser": {
      "types": "./lib/browser.d.ts",
      "default": "./lib/browser.js"
    },
    "types": "./lib/index.d.ts"
  },
  "types": "./lib/index.d.ts",
  "scripts": {
    "build": "node lib/prebuild.mjs compile",
    "install": "node lib/prebuild.mjs download --or-compile",
    "upload": "node lib/prebuild.mjs upload",
    "snapshot": "node lib/prebuild.mjs snapshot",
    "test": "node --test",
    "test:static": "node --test \"tests/static/*.test.js\"",
    "test:suite": "node --test \"tests/suite/*.test.js\"",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "sync-targets": "node scripts/platform-package.mjs sync",
    "typecheck": "tsc --project tsconfig.json"
  },
  "dependencies": {
    "detect-libc": "^2.1.1",
    "follow-redirects": "^1.15.11",
    "https-proxy-agent": "^9.1.0",
    "string-split-by": "^1.0.0"
  },
  "peerDependencies": {
    "sharp": ">=0.33.0"
  },
  "peerDependenciesMeta": {
    "sharp": {
      "optional": true
    }
  },
  "devDependencies": {
    "@hono/node-server": "^2.1.0",
    "@types/node": "^26.1.2",
    "cargo-cp-artifact": "^0.1",
    "hono": "^4.9.8",
    "nock": "^14.0.10",
    "prettier": "^3.9.6",
    "sharp": "^0.35.3",
    "tmp": "^0.2.5",
    "typescript": "^7.0.2"
  },
  "files": [
    "lib/*js",
    "lib/*ts",
    "lib/classes/*js",
    "lib/fonts",
    "lib/*.json"
  ],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "keywords": [
    "canvas",
    "gpu",
    "skia",
    "offscreen",
    "headless",
    "graphic",
    "graphics",
    "image",
    "images",
    "compositing",
    "render",
    "vulkan",
    "metal",
    "pdf",
    "svg",
    "rust"
  ],
  "prebuild": {
    "aws-lambda-arm64.zip": "sha256:5e88e0c35f14df54616053b50b6daf1e659fd09658bb1347cbbe6925643fa1bc",
    "aws-lambda-x64.zip": "sha256:2574bd5e9c6c1b752c63035af4f65ed42213dbd6023f3e153360929647d74403",
    "darwin-arm64.gz": "sha256:ca405287b40c70978903b4490121b2f10aee17f3fe78539e160a414276eebbe2",
    "linux-arm64-glibc.gz": "sha256:8590ee9fdae01fceb87a173d022c9be5a3002fa4dceb2ec55274b3c11cd6e13c",
    "linux-arm64-musl.gz": "sha256:d6875417818513863484063844309df66fce26d7aff03e0333fb522a1d9d459a",
    "linux-x64-glibc.gz": "sha256:6e582a30a6dbac90f4560aec15d1189f208a84dd5cdc2cdaa80250af0c6feff3",
    "linux-x64-musl.gz": "sha256:f32c012a52a681e4a643e39c7299a08a7a2de763e5566e41e18bc5df67a408ec",
    "win32-arm64.gz": "sha256:ae84e1d6806010019400813847b11884a8283b764ae8b001f2aecd670be9e063",
    "win32-x64.gz": "sha256:3c347e2fe00c4b8278c6f34bafc19273f946df6be9ba06ced856f334885de626"
  },
  "contributors": [
    "Christian Swinehart <drafting@samizdat.co>"
  ]
}
