{
  "name": "meo-skia-canvas",
  "version": "5.1.0",
  "description": "A multi-threaded, GPU-accelerated 2D graphics environment for Node: the HTML Canvas API on Skia, with GUI windows, animation, and twelve export formats",
  "author": "L A Romeo <ukasyahrz@outlook.com>",
  "license": "MIT",
  "homepage": "https://github.com/l7aromeo/meo-skia-canvas",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/l7aromeo/meo-skia-canvas.git"
  },
  "bugs": {
    "url": "https://github.com/l7aromeo/meo-skia-canvas/issues"
  },
  "main": "./lib/index.js",
  "exports": {
    "node": {
      "import": "./lib/index.mjs",
      "require": "./lib/index.js"
    },
    "browser": {
      "types": "./lib/browser.d.ts",
      "default": "./lib/browser.js"
    },
    "types": "./lib/index.d.ts"
  },
  "types": "./lib/index.d.ts",
  "scripts": {
    "build": "node lib/prebuild.mjs compile",
    "install": "node lib/prebuild.mjs download --or-compile",
    "upload": "node lib/prebuild.mjs upload",
    "snapshot": "node lib/prebuild.mjs snapshot",
    "test": "node --test",
    "test:static": "node --test \"tests/static/*.test.js\"",
    "test:suite": "node --test \"tests/suite/*.test.js\"",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "sync-targets": "node scripts/platform-package.mjs sync",
    "typecheck": "tsc --project tsconfig.json"
  },
  "dependencies": {
    "detect-libc": "^2.1.1",
    "follow-redirects": "^1.15.11",
    "https-proxy-agent": "^9.1.0",
    "string-split-by": "^1.0.0"
  },
  "peerDependencies": {
    "sharp": ">=0.33.0"
  },
  "peerDependenciesMeta": {
    "sharp": {
      "optional": true
    }
  },
  "devDependencies": {
    "@hono/node-server": "^2.1.0",
    "@types/node": "^26.1.2",
    "cargo-cp-artifact": "^0.1",
    "hono": "^4.9.8",
    "nock": "^14.0.10",
    "prettier": "^3.9.6",
    "sharp": "^0.35.3",
    "tmp": "^0.2.5",
    "typescript": "^7.0.2"
  },
  "files": [
    "lib/*js",
    "lib/*ts",
    "lib/classes/*js",
    "lib/fonts",
    "lib/*.json"
  ],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "keywords": [
    "canvas",
    "gpu",
    "skia",
    "offscreen",
    "headless",
    "graphic",
    "graphics",
    "image",
    "images",
    "compositing",
    "render",
    "vulkan",
    "metal",
    "pdf",
    "svg",
    "rust"
  ],
  "prebuild": {
    "aws-lambda-arm64.zip": "sha256:8c25ea562c52882712b535f9fb9364ae573e8d2e8f94092ad62fc2c199211672",
    "aws-lambda-x64.zip": "sha256:bae0a16e1c39f037bd0b6d8a3bae50fbcddddae70bf49998e97c3f02022a18f5",
    "darwin-arm64.gz": "sha256:a1c0736ae21d66242e91265aa890a06b5be4aad7f30777903e83af404f3ea8fc",
    "linux-arm64-glibc.gz": "sha256:83bc2b7a86607a6e7bceeb684027d54483785fa2decbb7723efc5d8abefbc634",
    "linux-arm64-musl.gz": "sha256:d271a24e697ca9acea93a226448c5c40ee8842a4261596cb1d321e597f7342a5",
    "linux-x64-glibc.gz": "sha256:09f4649aae67e3a4c9bf27ddee1222afc623a32707909e2065e2ef703ef04909",
    "linux-x64-musl.gz": "sha256:91f019f29a961cd6628ba53db9df246103bd165dd09ad7f64a5de918bd810fe9",
    "win32-arm64.gz": "sha256:7fae54b55efce75c2728ad0e021210017cb9042cd1e89dfbb094e145c49bee2c",
    "win32-x64.gz": "sha256:d341eaae6cca3af11dd11fab489ea13fdca86a25031cf649b3c5266b0ae11362"
  },
  "contributors": [
    "Christian Swinehart <drafting@samizdat.co>"
  ],
  "optionalDependencies": {
    "meo-skia-canvas-darwin-arm64": "5.1.0",
    "meo-skia-canvas-linux-x64-glibc": "5.1.0",
    "meo-skia-canvas-linux-x64-musl": "5.1.0",
    "meo-skia-canvas-linux-arm64-glibc": "5.1.0",
    "meo-skia-canvas-linux-arm64-musl": "5.1.0",
    "meo-skia-canvas-win32-x64": "5.1.0",
    "meo-skia-canvas-win32-arm64": "5.1.0"
  }
}
