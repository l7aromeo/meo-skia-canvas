{
  "name": "meo-skia-canvas",
  "version": "5.7.0",
  "description": "A multi-threaded, GPU-accelerated 2D graphics environment for Node: the HTML Canvas API on Skia, with GUI windows, animation, and export to raster and vector formats",
  "author": "L A Romeo <ukasyahrz@outlook.com>",
  "license": "MIT",
  "homepage": "https://github.com/l7aromeo/meo-skia-canvas",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/l7aromeo/meo-skia-canvas.git"
  },
  "bugs": {
    "url": "https://github.com/l7aromeo/meo-skia-canvas/issues"
  },
  "main": "./lib/index.js",
  "exports": {
    "node": {
      "import": "./lib/index.mjs",
      "require": "./lib/index.js"
    },
    "browser": {
      "types": "./lib/browser.d.ts",
      "default": "./lib/browser.js"
    },
    "types": "./lib/index.d.ts"
  },
  "types": "./lib/index.d.ts",
  "scripts": {
    "build": "node lib/prebuild.mjs compile",
    "install": "node lib/prebuild.mjs download --or-compile",
    "upload": "node lib/prebuild.mjs upload",
    "snapshot": "node lib/prebuild.mjs snapshot",
    "test": "node --test",
    "test:static": "node --test \"tests/static/*.test.js\"",
    "test:suite": "node --test \"tests/suite/*.test.js\"",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "sync-targets": "node scripts/platform-package.mjs sync",
    "typecheck": "tsc --project tsconfig.json"
  },
  "dependencies": {
    "detect-libc": "^2.1.1",
    "follow-redirects": "^1.15.11",
    "https-proxy-agent": "^9.1.0",
    "string-split-by": "^1.0.0"
  },
  "peerDependencies": {
    "sharp": ">=0.33.0"
  },
  "peerDependenciesMeta": {
    "sharp": {
      "optional": true
    }
  },
  "devDependencies": {
    "@hono/node-server": "^2.1.0",
    "@types/node": "^26.1.2",
    "cargo-cp-artifact": "^0.1",
    "hono": "^4.9.8",
    "nock": "^14.0.10",
    "prettier": "^3.9.6",
    "sharp": "^0.35.3",
    "tmp": "^0.2.5",
    "typescript": "^7.0.2"
  },
  "files": [
    "lib/*js",
    "lib/*ts",
    "lib/classes/*js",
    "lib/fonts",
    "lib/*.json"
  ],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "keywords": [
    "canvas",
    "gpu",
    "skia",
    "offscreen",
    "headless",
    "graphic",
    "graphics",
    "image",
    "images",
    "compositing",
    "render",
    "vulkan",
    "metal",
    "pdf",
    "svg",
    "rust"
  ],
  "prebuild": {
    "aws-lambda-arm64.zip": "sha256:cebd3bd0f863a6cbc78e729ac025db6b4d063ffb0f804de31c337fc540fc2d06",
    "aws-lambda-x64.zip": "sha256:ec7704c36665d7f80018dd671ee6390601af1d304becbe85a6c9674601e8c339",
    "darwin-arm64.gz": "sha256:a065264f822627acc09cad3f8adbaa099ac9cd9df69808a9028ad9f0af80b98c",
    "linux-arm64-glibc.gz": "sha256:ef69270a4fb33ac94266cf2cb14ff007d0321d8268b7f8293f4184d82e304df7",
    "linux-arm64-musl.gz": "sha256:1d274ef6b4c99f3c27528d196b8c9bac032105e865dba64042bb0cb3cae3eebf",
    "linux-x64-glibc.gz": "sha256:33b36685f1715de55968d48d88ad1c7298ec1a7960e6cbaca5f47f6683cd9994",
    "linux-x64-musl.gz": "sha256:5b5458a74edfb8d3e162f6851de89db99a9bf2d36067c821c9edf1b6ef50fce8",
    "win32-arm64.gz": "sha256:57c5863b6c1df434266127b0ed0f0f0f516cf3b790d6e5487c09998bef923ef9",
    "win32-x64.gz": "sha256:dc5ddb56c646311b3dc3d60515e4a537fd3b4bad6b8c862c98a7870d74d807dc"
  },
  "contributors": [
    "Christian Swinehart <drafting@samizdat.co>"
  ]
}
