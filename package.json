{
  "name": "meo-skia-canvas",
  "version": "5.7.0",
  "description": "A multi-threaded, GPU-accelerated 2D graphics environment for Node: the HTML Canvas API on Skia, with GUI windows, animation, and export to raster and vector formats",
  "author": "L A Romeo <ukasyahrz@outlook.com>",
  "license": "MIT",
  "homepage": "https://github.com/l7aromeo/meo-skia-canvas",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/l7aromeo/meo-skia-canvas.git"
  },
  "bugs": {
    "url": "https://github.com/l7aromeo/meo-skia-canvas/issues"
  },
  "main": "./lib/index.js",
  "exports": {
    "node": {
      "import": "./lib/index.mjs",
      "require": "./lib/index.js"
    },
    "browser": {
      "types": "./lib/browser.d.ts",
      "default": "./lib/browser.js"
    },
    "types": "./lib/index.d.ts"
  },
  "types": "./lib/index.d.ts",
  "scripts": {
    "build": "node lib/prebuild.mjs compile",
    "install": "node lib/prebuild.mjs download --or-compile",
    "upload": "node lib/prebuild.mjs upload",
    "snapshot": "node lib/prebuild.mjs snapshot",
    "test": "node --test",
    "test:static": "node --test \"tests/static/*.test.js\"",
    "test:suite": "node --test \"tests/suite/*.test.js\"",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "sync-targets": "node scripts/platform-package.mjs sync",
    "typecheck": "tsc --project tsconfig.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "dependencies": {
    "detect-libc": "^2.1.1",
    "follow-redirects": "^1.15.11",
    "https-proxy-agent": "^9.1.0",
    "string-split-by": "^1.0.0"
  },
  "peerDependencies": {
    "sharp": ">=0.33.0"
  },
  "peerDependenciesMeta": {
    "sharp": {
      "optional": true
    }
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@hono/node-server": "^2.1.0",
    "@types/node": "^26.4.1",
    "cargo-cp-artifact": "^0.1",
    "eslint": "^10.10.0",
    "globals": "^17.12.0",
    "hono": "^4.9.8",
    "nock": "^14.0.10",
    "prettier": "^3.9.6",
    "sharp": "^0.35.3",
    "tmp": "^0.2.5",
    "typescript": "^7.0.2"
  },
  "files": [
    "lib/*js",
    "lib/*ts",
    "lib/classes/*js",
    "lib/fonts",
    "lib/*.json"
  ],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "keywords": [
    "canvas",
    "gpu",
    "skia",
    "offscreen",
    "headless",
    "graphic",
    "graphics",
    "image",
    "images",
    "compositing",
    "render",
    "vulkan",
    "metal",
    "pdf",
    "svg",
    "rust"
  ],
  "prebuild": {
    "aws-lambda-arm64.zip": "sha256:1b5946e9e118bc8bbc605bb79f0bff44f742fd5629327c3a7db5477294520d95",
    "aws-lambda-x64.zip": "sha256:f7c1c176c11756b0e7290bf64bbacd2840ed31d90964f4e6f9a58910162839c4",
    "darwin-arm64.gz": "sha256:9c43ce5992ba63052ccd8eedd515e20c5ea6f5f2f58f4f9c98b66121d625dcdb",
    "linux-arm64-glibc.gz": "sha256:a1752da8f7b53f062e14ce07b936447811bebcc7ea5f945f777b4310b7464ac1",
    "linux-arm64-musl.gz": "sha256:e10c9862a9da7a9b7e4d79b0f9bc95a30de8fe92f56475003a8b6b9014ed0748",
    "linux-x64-glibc.gz": "sha256:656b5bef115bc0fe4c8981d9ae84c18adcfc03c8c8bd80fe6e73348c202c4588",
    "linux-x64-musl.gz": "sha256:0d357aa4c854024c0558669ddc6464fa397aec14371a5c6c295057f3b751b94e",
    "win32-arm64.gz": "sha256:bb37a54499337a4b24176b09ef0e06b560a2cb88817f6974db7213cbbaa59efc",
    "win32-x64.gz": "sha256:65084264fe61eae29efb51345ed1d3985183b80a2cb04b1aad7f01276e6dd331"
  },
  "contributors": [
    "Christian Swinehart <drafting@samizdat.co>"
  ],
  "optionalDependencies": {
    "meo-skia-canvas-darwin-arm64": "5.7.0",
    "meo-skia-canvas-linux-x64-glibc": "5.7.0",
    "meo-skia-canvas-linux-x64-musl": "5.7.0",
    "meo-skia-canvas-linux-arm64-glibc": "5.7.0",
    "meo-skia-canvas-linux-arm64-musl": "5.7.0",
    "meo-skia-canvas-win32-x64": "5.7.0",
    "meo-skia-canvas-win32-arm64": "5.7.0"
  }
}
