{
  "name": "meo-skia-canvas",
  "version": "5.6.1",
  "description": "A multi-threaded, GPU-accelerated 2D graphics environment for Node: the HTML Canvas API on Skia, with GUI windows, animation, and export to raster and vector formats",
  "author": "L A Romeo <ukasyahrz@outlook.com>",
  "license": "MIT",
  "homepage": "https://github.com/l7aromeo/meo-skia-canvas",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/l7aromeo/meo-skia-canvas.git"
  },
  "bugs": {
    "url": "https://github.com/l7aromeo/meo-skia-canvas/issues"
  },
  "main": "./lib/index.js",
  "exports": {
    "node": {
      "import": "./lib/index.mjs",
      "require": "./lib/index.js"
    },
    "browser": {
      "types": "./lib/browser.d.ts",
      "default": "./lib/browser.js"
    },
    "types": "./lib/index.d.ts"
  },
  "types": "./lib/index.d.ts",
  "scripts": {
    "build": "node lib/prebuild.mjs compile",
    "install": "node lib/prebuild.mjs download --or-compile",
    "upload": "node lib/prebuild.mjs upload",
    "snapshot": "node lib/prebuild.mjs snapshot",
    "test": "node --test",
    "test:static": "node --test \"tests/static/*.test.js\"",
    "test:suite": "node --test \"tests/suite/*.test.js\"",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "sync-targets": "node scripts/platform-package.mjs sync",
    "typecheck": "tsc --project tsconfig.json"
  },
  "dependencies": {
    "detect-libc": "^2.1.1",
    "follow-redirects": "^1.15.11",
    "https-proxy-agent": "^9.1.0",
    "string-split-by": "^1.0.0"
  },
  "peerDependencies": {
    "sharp": ">=0.33.0"
  },
  "peerDependenciesMeta": {
    "sharp": {
      "optional": true
    }
  },
  "devDependencies": {
    "@hono/node-server": "^2.1.0",
    "@types/node": "^26.1.2",
    "cargo-cp-artifact": "^0.1",
    "hono": "^4.9.8",
    "nock": "^14.0.10",
    "prettier": "^3.9.6",
    "sharp": "^0.35.3",
    "tmp": "^0.2.5",
    "typescript": "^7.0.2"
  },
  "files": [
    "lib/*js",
    "lib/*ts",
    "lib/classes/*js",
    "lib/fonts",
    "lib/*.json"
  ],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "keywords": [
    "canvas",
    "gpu",
    "skia",
    "offscreen",
    "headless",
    "graphic",
    "graphics",
    "image",
    "images",
    "compositing",
    "render",
    "vulkan",
    "metal",
    "pdf",
    "svg",
    "rust"
  ],
  "prebuild": {
    "aws-lambda-arm64.zip": "sha256:a7118cc17c6a98ccad19949de140f3d3db534ebae92a9f7db3c0c7ee8b3c7497",
    "aws-lambda-x64.zip": "sha256:8e84f24b32eb97f06321e371e03ad790b2d959cf5a8a86dc5fdf08e129336e63",
    "darwin-arm64.gz": "sha256:13879c5972d15c466db57169b2a901b54cc2d19dbf4d258bcb93c276bf3c10ca",
    "linux-arm64-glibc.gz": "sha256:83eb10e48c304f95a1e891ff910ee623dc547a52bd3423aa199bfd6067bb8fee",
    "linux-arm64-musl.gz": "sha256:1a65350fe815c3e4928ab170f40c56d226eb1b4d2b0f4230dddf71ce0e996299",
    "linux-x64-glibc.gz": "sha256:903541c67fb4e73547ddc42c96d5abae84bda4a68dc71397d95acfda86663431",
    "linux-x64-musl.gz": "sha256:d62daa561b1fa5860d5c7e34d9f9aa5630ab65691c92a3c2caf5441b8e5626ca",
    "win32-arm64.gz": "sha256:1940407b0397b7b33f560e2571572a4406a3252aac04b844feb54043d4c8d1ce",
    "win32-x64.gz": "sha256:0fb4478cbfeb51bfedcb20e01e34a7d93edced1e70212e8a0fb79187a02b84af"
  },
  "contributors": [
    "Christian Swinehart <drafting@samizdat.co>"
  ]
}
