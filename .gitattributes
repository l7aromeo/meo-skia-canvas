# Normalize text to LF in the working tree on every platform. Without this,
# Windows checks out CRLF via core.autocrlf and `prettier --check` fails on every
# JavaScript file at once -- 37 of them, on the first run of the format gate --
# because .prettierrc.json pins endOfLine to lf.
#
# The binary rules below re-clear `text` for their own patterns; the last matching
# line wins per attribute, so LFS assets keep `-text` and are never munged.
* text=auto eol=lf

*.png filter=lfs diff=lfs merge=lfs -text
*.jpg filter=lfs diff=lfs merge=lfs -text
*.jpeg filter=lfs diff=lfs merge=lfs -text
*.webp filter=lfs diff=lfs merge=lfs -text
*.pdf filter=lfs diff=lfs merge=lfs -text
*.bmp filter=lfs diff=lfs merge=lfs -text
*.gif filter=lfs diff=lfs merge=lfs -text
*.apng filter=lfs diff=lfs merge=lfs -text
*.avif filter=lfs diff=lfs merge=lfs -text
*.ico filter=lfs diff=lfs merge=lfs -text
*.ttf filter=lfs diff=lfs merge=lfs -text
*.otf filter=lfs diff=lfs merge=lfs -text
*.woff filter=lfs diff=lfs merge=lfs -text
*.woff2 filter=lfs diff=lfs merge=lfs -text

# Test fixtures are deliberately not in LFS. They are 1.4 MB of small files that
# change rarely, so LFS buys nothing on size, and any checkout that pulls them also
# pays for the 22 MB in docs/assets, which no CI job reads.
#
# Cargo.toml's `include` ships tests/assets/images/pentagon.png and the Oswald
# variable font inside the crate. As ordinary blobs they package as real bytes from
# any checkout; under LFS, a checkout without `lfs: true` puts pointer text into an
# immutable crates.io release.
#
# `text` is left alone here: the per-extension rules above already clear it for
# every binary form, and the licence and SVG files under this path want the
# repository-wide LF normalisation that the first rule gives them.
tests/assets/** -filter -diff -merge
