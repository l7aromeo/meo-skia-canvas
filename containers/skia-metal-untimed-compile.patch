+// rust-skia: `@available` needs `___isPlatformVersionAtLeast` from compiler-rt,
+// which the final link of a Rust binary does not provide, so the version is
+// asked for at run time. Hard-coding `false` instead sent every compile through
+// the one-second timeouts below, and a timed-out compile drops its draw.
+bool GrMtlCompilesWithoutTimeout() {
+#if TARGET_OS_OSX
+    static const bool kUntimed = [[NSProcessInfo processInfo]
+            isOperatingSystemAtLeastVersion:(NSOperatingSystemVersion){10, 15, 0}];
+    return kUntimed;
+#else
+    return true;
+#endif
+}
