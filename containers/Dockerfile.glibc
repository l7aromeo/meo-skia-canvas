# AlmaLinux 8, and the glibc version is the entire reason.
#
# The final stage's glibc is the floor for every binary built here, because nothing can link
# against symbol versions its sysroot does not have. EL8 is glibc 2.28.
#
# This used to be Debian: bullseye tooling stages and a node:bookworm-slim final stage. The header
# claimed a 2.28 target while bookworm delivered 2.36, and nothing caught the gap for the life of
# the fork -- binaries required GLIBC_2.35 and could not load on AWS Lambda (Amazon Linux 2023 is
# 2.34), RHEL 9 (2.34), Ubuntu 20.04 or Debian 11. The published aws-lambda-*.zip layers had never
# worked on any release. See #7.
#
# What 2.28 covers, measured from the images rather than assumed:
#
#   RHEL / Rocky / Alma 8            2.28   ok, to 2029
#   Ubuntu 20.04                     2.31   ok
#   AWS Lambda / Amazon Linux 2023   2.34   ok, to 2028
#   RHEL / Rocky / Alma 9            2.34   ok, to 2032
#   Ubuntu 22.04                     2.35   ok
#   Debian 12 bookworm               2.36   ok
#
# Why EL8 rather than an old Debian: bullseye would give 2.31, which also clears Lambda, but Debian
# 11's LTS ends in August 2026 -- the build base would be unpatched from that point. AlmaLinux 8
# tracks RHEL 8 to 2029 and carries clang 21 in AppStream. It is also the base PyPA uses for
# manylinux_2_28, so this is a well-worn path for shipping portable native binaries.
#
# build.yml asserts the resulting floor after every Linux build, and a separate job loads the
# published AWS layer on the real Lambda runtime, so this cannot drift again unnoticed.

# --------------------------------------------------------------------------------------------------------

FROM almalinux:8 AS dependencies

# PowerTools carries gperf, which fontconfig's build needs. clang 21 is in AppStream; the previous
# Debian stages pulled it from apt.llvm.org via install-llvm.sh, which has no EL equivalent and is
# no longer needed.
ARG LLVM_VERSION=21
RUN dnf -y install dnf-plugins-core && \
    dnf config-manager --set-enabled powertools && \
    dnf -y module enable python39 && \
    dnf -y install \
      clang llvm-toolset \
      gcc gcc-c++ make cmake \
      python39 python39-pip \
      pkgconf-pkg-config perl curl wget tar xz unzip \
      expat-devel libpng-devel gperf && \
    dnf clean all

# install-fontlibs.sh calls `python3 -m venv`, and EL8's default python3 is 3.6, which recent meson
# refuses. Point python3 at 3.9 rather than editing the script, so the musl image can keep sharing
# it unchanged.
RUN alternatives --set python3 /usr/bin/python3.9

# EL8 packages ninja 1.8.2, from 2017. Debian bullseye had 1.10.1, and Skia's GN build expects
# something modern, so the packaged one is a regression that would surface hours into a Skia
# compile. Pinned to an official release binary instead.
ARG NINJA_VERSION=1.13.1
RUN NINJA_ASSET=$([ "$(uname -m)" = "aarch64" ] && echo ninja-linux-aarch64.zip || echo ninja-linux.zip) && \
    curl -sfL --retry 3 -o /tmp/ninja.zip \
      "https://github.com/ninja-build/ninja/releases/download/v${NINJA_VERSION}/${NINJA_ASSET}" && \
    unzip -q -o /tmp/ninja.zip -d /usr/local/bin && rm /tmp/ninja.zip && \
    chmod +x /usr/local/bin/ninja && ninja --version

# install-fontlibs.sh builds freetype into /usr/local, then fontconfig looks for it through
# pkg-config. Debian searches /usr/local/lib/pkgconfig by default; EL8 does not, so fontconfig's
# meson step fails with "Dependency 'freetype' is required but not found". Set here rather than in
# the script, which the musl image shares and where the default path already works.
ENV PKG_CONFIG_PATH=/usr/local/lib/pkgconfig:/usr/local/lib64/pkgconfig
ENV LD_LIBRARY_PATH=/usr/local/lib:/usr/local/lib64

# manually build freetype & fontconfig and install fontconfig in /usr/local
COPY ./install-fontlibs.sh /opt
COPY ./freetype.cfg /opt
RUN bash /opt/install-fontlibs.sh

# move static fontconfig to a common location (freetype BDF stubs are in skia-canvas)
RUN mkdir -p /opt/skia-static-libs && \
    cp /usr/local/lib*/libfontconfig.a /opt/skia-static-libs 2>/dev/null || \
    cp /usr/local/lib/*/libfontconfig.a /opt/skia-static-libs

# --------------------------------------------------------------------------------------------------------

FROM almalinux:8 AS skia-build-env
ARG TARGETARCH

# EL8 ships git 2.43, new enough for Skia's submodules. The Debian build had a whole stage
# compiling git from source because bullseye only had 2.30; that stage is gone.
#
# gcc-toolset-14 is here for its libstdc++, not its compiler. clang supplies the compiler, but the
# C++ standard library comes from whichever GCC it finds, and EL8's default is 8.5 — which has no
# <bit>, so Skia fails on SkMathPriv.h with "fatal error: 'bit' file not found". Debian's GCC 10
# and 12 both had it, which is why this only appeared after the move to EL8.
#
# Installing it is necessary but not sufficient — see the clang config file further down, which is
# what actually makes clang use it once Skia passes an explicit --target.
ARG LLVM_VERSION=21
RUN dnf -y install dnf-plugins-core && \
    dnf config-manager --set-enabled powertools && \
    dnf -y install \
      clang llvm-toolset \
      gcc gcc-c++ make \
      gcc-toolset-14 \
      git git-lfs \
      pkgconf-pkg-config perl curl wget tar xz zip unzip findutils \
      patch diffutils which \
      dejavu-sans-fonts && \
    dnf clean all
# ninja is not installed here: the COPY of /usr/local from the dependencies stage below brings the
# pinned 1.13 binary with it, and Docker merges into an existing directory rather than replacing
# it, so Node installed above survives.

# Node is installed from the official tarball: EL8's nodejs module streams stop at 20, which is
# end-of-life. Pinned exactly so the build runtime cannot move without a commit.
ARG NODE_VERSION=24.19.0
RUN NODE_ARCH=$([ "$TARGETARCH" = "arm64" ] && echo arm64 || echo x64) && \
    curl -sfL --retry 3 "https://nodejs.org/dist/v${NODE_VERSION}/node-v${NODE_VERSION}-linux-${NODE_ARCH}.tar.xz" \
      | tar xJf - --strip-components=1 -C /usr/local && \
    node --version && npm --version

# Point clang at gcc-toolset's libstdc++ unconditionally.
#
# Installing gcc-toolset is not enough on its own. clang finds a GCC installation by matching the
# *target triple*, and skia-bindings passes `--target=<arch>-linux-gnu` derived from the Rust
# triple, while gcc-toolset installs under `<arch>-redhat-linux`. The triples do not match, so
# clang silently falls back to the system GCC 8 and Skia dies on:
#
#   skia/src/base/SkMathPriv.h:15:10: fatal error: 'bit' file not found
#
# This is invisible to a bare `clang++ -std=c++20` test, which has no --target and therefore does
# find the toolset. It only appears once Skia's own flags are involved.
#
# A config file in clang's system config directory applies to every invocation regardless of how
# the build drives it, which a wrapper script or an env var would not reliably do. Pinned to 14
# rather than whichever toolset happens to be newest, so the C++ runtime is deterministic.
RUN GCCDIR="$(ls -d /opt/rh/gcc-toolset-14/root/usr/lib/gcc/*/14 | head -1)" && \
    test -n "$GCCDIR" && \
    mkdir -p /etc/clang && \
    printf -- '--gcc-install-dir=%s\n' "$GCCDIR" | tee /etc/clang/clang++.cfg > /etc/clang/clang.cfg && \
    printf '#include <bit>\n#include <cstdint>\nint main(){ return std::countl_zero((uint32_t)1); }\n' > /tmp/abi.cc && \
    clang++ --target="$(uname -m)-linux-gnu" -std=c++20 -c /tmp/abi.cc -o /tmp/abi.o && \
    rm -f /tmp/abi.cc /tmp/abi.o && \
    echo "clang finds C++20 headers under --target: ok"

# skia-bindings builds its own binding shim through the `cc` crate, which defaults to `cc`/`c++`
# on Linux — the system GCC 8 here, which does not recognise `-std=c++20`:
#
#   c++: error: unrecognized command line option '-std=c++20'; did you mean '-std=c++2a'?
#
# Debian's g++ 12 accepted it, so this only appears on EL8. Skia's own GN build already uses clang;
# this points the crate at the same compiler rather than leaving two toolchains in one build.
ENV CC=clang \
    CXX=clang++

# libstdc++ is the second ABI constraint, and a GLIBCXX symbol newer than the target's fails at
# load exactly like a glibc one. What the supported platforms ship:
#
#   RHEL / UBI 8                     GLIBCXX 3.4.25
#   RHEL / UBI 9                     GLIBCXX 3.4.29
#   AWS Lambda / Amazon Linux 2023   GLIBCXX 3.4.33
#
# The Debian build required 3.4.30, so RHEL 9 could not load it even ignoring glibc.
#
# gcc-toolset already solves this, which is worth knowing before anyone "fixes" it: it links its
# own newer libstdc++ statically and leaves only the old baseline symbols dynamic. A real build
# here measured GLIBCXX 3.4.21 — GCC 5 era, under every platform above.
#
# gcc-toolset's partial static linking is NOT enough on its own, and version numbers hide why.
# A build with `-C link-arg=-static-libstdc++` alone still produced a binary that reported
# GLIBCXX_3.4.21 — comfortably low — yet failed to load with:
#
#   undefined symbol: std::__cxx11::basic_string<...>::_M_replace_cold(...)
#
# `_M_replace_cold` arrived in GCC 12 and carries no GLIBCXX_ version tag, so a symbol-version
# ceiling cannot see it. Compiled against gcc-toolset-14's headers, resolved against the system
# GCC 8 libstdc++ at load, missing.
#
# The flag was being dropped: rustc links through `cc`, the C driver, which does not act on
# -static-libstdc++. Pointing the linker at clang++ makes it a C++ link and the flag takes, so
# libstdc++ is genuinely absorbed and nothing is resolved at load. build.yml asserts
# libstdc++.so.6 is not in NEEDED, which is the only check that catches this.
ENV RUSTFLAGS="-C linker=clang++ -C link-arg=-static-libstdc++"

# install gh
ARG GH_VERSION=2.86.0
ARG GH_URL=https://github.com/cli/cli/releases/download/v$GH_VERSION/gh_${GH_VERSION}_linux_$TARGETARCH.tar.gz
RUN curl -sfL --retry 3 $GH_URL | tar xz --strip-components=2 -C /usr/local/bin

# copy over results of previous build stage
COPY --from=dependencies /usr/local /usr/local
COPY --from=dependencies /opt/skia-static-libs /opt/skia-static-libs

WORKDIR /opt

CMD ["bash"]
