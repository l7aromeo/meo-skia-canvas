# Every stage is bullseye, and that is the point: the glibc of the final stage is the floor for
# every binary built here, because nothing can link against symbol versions the sysroot does not
# have. bullseye is glibc 2.31.
#
# This comment used to describe buster (2.28) while the final stage was node:bookworm-slim (2.36),
# and nothing caught the gap for the life of the fork. Binaries required GLIBC_2.35 and so could
# not load on AWS Lambda (Amazon Linux 2023 is 2.34), RHEL 9 (2.34), Ubuntu 20.04 or Debian 11.
# The aws-lambda-*.zip layers had never worked on any release. See #7.
#
# What 2.31 covers, measured from the images rather than assumed:
#
#   AWS Lambda / Amazon Linux 2023   2.34   ok
#   RHEL / UBI 9                     2.34   ok
#   Ubuntu 22.04                     2.35   ok
#   Debian 12 bookworm               2.36   ok
#   Ubuntu 24.04                     2.39   ok
#   RHEL / UBI 8                     2.28   not covered
#
# Reaching 2.28 means a RHEL 8 base, where clang 21 is not packaged and would have to be built
# from source. Not worth one distro generation.
#
# build.yml asserts the resulting floor, so this cannot drift again unnoticed.

# --------------------------------------------------------------------------------------------------------

FROM debian:bullseye-slim AS git

RUN apt-get update && apt-get install -y -q \
    wget curl gpg software-properties-common pkg-config \
    build-essential libssl-dev libcurl4-gnutls-dev gettext \
    zlib1g-dev libpcre2-dev libexpat1-dev

# upgrade git to a version that can handle skia's submodules correctly
ARG GIT_VERSION=2.50.1
ARG GIT_URL=https://github.com/git/git/archive/refs/tags/v$GIT_VERSION.tar.gz
RUN curl -sL $GIT_URL | tar xz -C /opt && \
    cd /opt/git-$GIT_VERSION && \
    NO_TCLTK=1 make -j 12 prefix=/usr/local install

# --------------------------------------------------------------------------------------------------------

FROM debian:bullseye-slim AS dependencies

RUN apt-get update && apt-get install -y -q \
    git perl curl wget gpg software-properties-common pkg-config \
    build-essential ninja-build cmake python3-venv lsb-release \
    libexpat1-dev libpng-dev gperf

# install clang v21
ARG LLVM_VERSION=21
COPY install-llvm.sh .
RUN bash install-llvm.sh $LLVM_VERSION

# manually build freetype & fontconfig and install fontconfig in /usr/local
COPY ./install-fontlibs.sh /opt
COPY ./freetype.cfg /opt
RUN bash /opt/install-fontlibs.sh

# move static fontconfig to a common location (freetype BDF stubs are in skia-canvas)
RUN mkdir -p /opt/skia-static-libs && \
    cp /usr/local/lib/*/libfontconfig.a /opt/skia-static-libs

# --------------------------------------------------------------------------------------------------------

# Pinned to a Node major as well: the tag was previously `node:bookworm-slim`, which floats to
# whatever Node is current and would have moved the build runtime without a commit.
FROM node:24-bullseye-slim AS skia-build-env
ARG TARGETARCH

RUN apt-get update && apt-get install -y -q \
  curl wget perl zip software-properties-common lsb-release build-essential ninja-build fonts-dejavu-core \
  git-lfs

# install clang v21
ARG LLVM_VERSION=21
COPY install-llvm.sh .
RUN bash install-llvm.sh $LLVM_VERSION

# install gh
ARG GH_VERSION=2.86.0
ARG GH_URL=https://github.com/cli/cli/releases/download/v$GH_VERSION/gh_${GH_VERSION}_linux_$TARGETARCH.tar.gz
RUN curl -sfL --retry 3 $GH_URL | tar xz --strip-components=2 -C /usr/local/bin

# copy over results of previous build stage
COPY --from=git /usr/local /usr/local
COPY --from=dependencies /usr/local /usr/local
COPY --from=dependencies /opt/skia-static-libs /opt/skia-static-libs

WORKDIR /opt

CMD ["bash"]
