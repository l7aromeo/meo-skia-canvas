+// Whether a paint's alpha is placed on a byte on this thread: on while a
+// raster playback that composites as a browser does is drawing the document,
+// and off for every other drawing of it.
+static thread_local bool gMeoBytePaintAlpha = false;
+
+// Sets whether this thread places each paint's alpha on a byte. A browser
+// paints an SVG with an eight-bit alpha: the product of a paint's colour
+// alpha, its `fill-opacity` or `stroke-opacity`, and the `opacity` folded into
+// it, rounded once. A half-float surface keeps that product unrounded, so a
+// tie such as 0.5 lands a level from the browser's byte.
+extern "C" void meo_svg_byte_paint_alpha(bool on) { gMeoBytePaintAlpha = on; }
+
+float SkSVGRenderContext::MeoPaintAlpha(float alpha) {
+    return gMeoBytePaintAlpha ? std::round(alpha * 255) / 255 : alpha;
+}
