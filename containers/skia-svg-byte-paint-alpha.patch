+bool SkSVGContainer::meoFoldsOpacityIntoChild() const {
+    if (fChildren.size() != 1) {
+        return false;
+    }
+    const SkSVGNode* child = fChildren[0].get();
+    switch (child->tag()) {
+        case SkSVGTag::kCircle:
+        case SkSVGTag::kEllipse:
+        case SkSVGTag::kLine:
+        case SkSVGTag::kPath:
+        case SkSVGTag::kPolygon:
+        case SkSVGTag::kPolyline:
+        case SkSVGTag::kRect:
+            return true;
+        case SkSVGTag::kG:
+            return static_cast<const SkSVGContainer*>(child)->meoFoldsOpacityIntoChild();
+        default:
+            // Text, <use> and <image> draw from contexts of their own or not
+            // through a paint, so a group over one of them keeps its layer.
+            return false;
+    }
+}
