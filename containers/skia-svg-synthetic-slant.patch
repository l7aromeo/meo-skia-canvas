+// Whether `tf` leans by its own design: a slant it reports, or `OS/2`
+// `fsSelection` bit 9, the oblique flag.
+static bool Leans(const SkTypeface* tf) {
+    if (tf->fontStyle().slant() != SkFontStyle::kUpright_Slant) {
+        return true;
+    }
+    // OpenType `OS/2` table: `fsSelection` is the uint16 at byte 62.
+    static constexpr size_t kFsSelectionOffset = 62;
+    static constexpr uint16_t kFsSelectionOblique = 1 << 9;
