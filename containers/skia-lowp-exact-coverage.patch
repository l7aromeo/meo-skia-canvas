+// `div255` is [3] off NEON, a level off about a quarter of the time, so the
+// same edge landed apart on x86 and arm64. Only partly covered pixels reach
+// these stages; the blends themselves keep their own division.
+SI U16 lerp(U16 from, U16 to, U16 t) { return div255_accurate( from*inv(t) + to*t ); }
 
