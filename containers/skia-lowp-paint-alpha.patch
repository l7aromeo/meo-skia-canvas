+// A paint's alpha scales the colour it draws with each channel's product
+// correctly rounded to a byte, on every platform. `div255` is [3] off
+// NEON, a level off for about a quarter of products, so the same image
+// drawn at the same alpha landed apart on x86 and arm64; `scale_1_float`
+// keeps it for coverage, which this stage does not replace.
+LOWP_STAGE_PP(scale_1_float_accurate, const float* f) {
+    U16 c = from_float(*f);
+    r = div255_accurate( r * c );
+    g = div255_accurate( g * c );
+    b = div255_accurate( b * c );
+    a = div255_accurate( a * c );
