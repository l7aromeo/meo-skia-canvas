+
+//
+// gpu/graphite/ImageProvider.h
+//
+
+// A provider that uploads a raster image with `SkImages::TextureFromImage` and
+// keeps the result, by the image's unique ID and whether it was asked for
+// mipmapped, least recently used first out once the kept bytes pass `budget`.
+// Graphite caches nothing for a client's provider (ImageProvider.h), and without
+// a provider at all it drops every raster image a Recorder draws. One provider
+// belongs to one Recorder: the textures it keeps are that Recorder's.
+namespace {
+class CachingImageProvider final : public skgpu::graphite::ImageProvider {
+public:
+    explicit CachingImageProvider(size_t budget) : fBudget(budget) {}
+
+    sk_sp<SkImage> findOrCreate(skgpu::graphite::Recorder* recorder,
+                                const SkImage* image,
+                                SkImage::RequiredProperties props) override {
+        const Key key{image->uniqueID(), props.fMipmapped};
+        std::lock_guard<std::mutex> lock(fMutex);
+        if (auto found = fIndex.find(key); found != fIndex.end()) {
+            fOrder.splice(fOrder.begin(), fOrder, found->second);
+            return found->second->fImage;
+        }
+        sk_sp<SkImage> made = SkImages::TextureFromImage(recorder, image, props);
+        if (!made) {
+            return nullptr;
+        }
+        const size_t bytes = made->imageInfo().computeMinByteSize();
+        // An image larger than the whole budget is drawn and not kept, rather
+        // than emptying the cache to hold it.
+        if (bytes > fBudget) {
+            return made;
+        }
+        fOrder.push_front(Entry{key, made, bytes});
+        fIndex.emplace(key, fOrder.begin());
+        fBytes += bytes;
+        while (fBytes > fBudget) {
+            const Entry& last = fOrder.back();
+            fBytes -= last.fBytes;
+            fIndex.erase(last.fKey);
+            fOrder.pop_back();
+        }
+        return made;
+    }
+
+    void purge() {
+        std::lock_guard<std::mutex> lock(fMutex);
+        fIndex.clear();
+        fOrder.clear();
+        fBytes = 0;
+    }
+
+    size_t keptBytes() const {
+        std::lock_guard<std::mutex> lock(fMutex);
+        return fBytes;
+    }
+
+private:
+    struct Key {
+        uint32_t fId;
+        bool fMipmapped;
+        bool operator==(const Key& other) const {
+            return fId == other.fId && fMipmapped == other.fMipmapped;
+        }
+    };
+    struct KeyHash {
+        size_t operator()(const Key& key) const {
+            return (static_cast<size_t>(key.fId) << 1) | static_cast<size_t>(key.fMipmapped);
+        }
+    };
+    struct Entry {
+        Key fKey;
+        sk_sp<SkImage> fImage;
+        size_t fBytes;
+    };
+
+    const size_t fBudget;
+    mutable std::mutex fMutex;
+    std::list<Entry> fOrder;
+    std::unordered_map<Key, std::list<Entry>::iterator, KeyHash> fIndex;
+    size_t fBytes = 0;
+};
+}  // namespace
+
+// Returned with a reference count of one, which the caller owns.
+extern "C" skgpu::graphite::ImageProvider* C_ImageProvider_MakeCaching(size_t budget) {
+    return new CachingImageProvider(budget);
+}
+
+// `self` is always a `CachingImageProvider`: `C_ImageProvider_MakeCaching` is the
+// only way the Rust side makes one.
+extern "C" void C_ImageProvider_purge(skgpu::graphite::ImageProvider* self) {
+    static_cast<CachingImageProvider*>(self)->purge();
+}
+
+extern "C" size_t C_ImageProvider_keptBytes(const skgpu::graphite::ImageProvider* self) {
+    return static_cast<const CachingImageProvider*>(self)->keptBytes();
+}
+
+// Takes a reference: the options hold `provider` alive, and so does the
+// Recorder made from them.
+extern "C" void C_RecorderOptions_setImageProvider(
+        skgpu::graphite::RecorderOptions* self,
+        skgpu::graphite::ImageProvider* provider) {
+    self->fImageProvider = sk_ref_sp(provider);
+}
+
+//
+// Context::asyncRescaleAndReadPixels, for an image
+//
+
+// `C_Context_readPixels` for a Graphite-backed image rather than a surface: the
+// image overload of `asyncRescaleAndReadPixels`, driven to completion the same
+// way. `false` where the read failed or never answered.
+extern "C" bool C_Context_readImagePixels(
+    skgpu::graphite::Context* self,
+    const SkImage* image,
+    const SkImageInfo* dstInfo,
+    void* dstPixels,
+    size_t dstRowBytes,
+    int srcX,
+    int srcY) {
+    SyncReadContext ctx;
+    ctx.fDst = dstPixels;
+    ctx.fDstRowBytes = dstRowBytes;
+    ctx.fMinRowBytes = dstInfo->minRowBytes();
+    ctx.fHeight = dstInfo->height();
+
+    SkIRect srcRect = SkIRect::MakeXYWH(srcX, srcY, dstInfo->width(), dstInfo->height());
+    self->asyncRescaleAndReadPixels(
+        image,
+        *dstInfo,
+        srcRect,
+        SkImage::RescaleGamma::kSrc,
+        SkImage::RescaleMode::kNearest,
+        &sync_read_callback,
+        &ctx);
+    self->submit(skgpu::graphite::SubmitInfo(skgpu::graphite::SyncToCpu::kYes));
+    int guard = 0;
+    while (!ctx.fCalled && guard++ < 10000) {
+        self->checkAsyncWorkCompletion();
+    }
+    return ctx.fCalled && ctx.fSuccess;
+}
