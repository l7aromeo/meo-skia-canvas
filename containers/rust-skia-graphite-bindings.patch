+    /// As [`Self::read_pixels`], for a Graphite-backed image rather than a
+    /// surface: what a caller holding only the image, and not the surface it
+    /// came from, reads back. `false` where the read failed or never answered.
+    pub fn read_image_pixels(
+        &mut self,
+        image: &Image,
+        dst_info: &ImageInfo,
+        dst_pixels: &mut [u8],
+        dst_row_bytes: usize,
+        src: impl Into<IPoint>,
+    ) -> bool {
+        let src = src.into();
+        if dst_row_bytes < dst_info.min_row_bytes() {
+            return false;
+        }
+        match dst_row_bytes.checked_mul(dst_info.height() as usize) {
+            Some(required) if dst_pixels.len() >= required => {}
+            _ => return false,
+        }
+
+        unsafe {
+            sb::C_Context_readImagePixels(
+                self.native_mut(),
+                image.native(),
+                dst_info.native(),
+                dst_pixels.as_mut_ptr() as *mut std::ffi::c_void,
+                dst_row_bytes,
+                src.x,
+                src.y,
+            )
+        }
+    }
 }
