diff --git a/skia-safe/src/gpu/graphite/image_provider.rs b/skia-safe/src/gpu/graphite/image_provider.rs
new file mode 100644
index 0000000..0994790
--- /dev/null
+++ b/skia-safe/src/gpu/graphite/image_provider.rs
@@ -0,0 +1,52 @@
+use std::fmt;
+
+use skia_bindings::{self as sb, SkRefCntBase, skgpu_graphite_ImageProvider};
+
+use crate::prelude::*;
+
+/// Supplies a Graphite-backed image wherever a [`super::Recorder`] draws a
+/// raster one. Without a provider a Recorder drops every raster image it is
+/// asked to draw.
+///
+/// The provider made by [`ImageProvider::new_caching`] uploads each image with
+/// `SkImages::TextureFromImage` and keeps the result, by the image's unique ID
+/// and whether it was asked for mipmapped, until the kept bytes pass its budget,
+/// least recently used first out. Graphite caches nothing for a client's
+/// provider, so the budget is the only bound. One provider belongs to one
+/// Recorder: the textures it keeps are that Recorder's.
+pub type ImageProvider = RCHandle<skgpu_graphite_ImageProvider>;
+unsafe_send_sync!(ImageProvider);
+
+impl NativeRefCountedBase for skgpu_graphite_ImageProvider {
+    type Base = SkRefCntBase;
+}
+
+impl fmt::Debug for ImageProvider {
+    fn fmt(&self, f: &mut fmt::Formatter) -> fmt::Result {
+        f.debug_struct("ImageProvider")
+            .field("kept_bytes", &self.kept_bytes())
+            .finish()
+    }
+}
+
+impl ImageProvider {
+    /// A provider that keeps up to `budget` bytes of uploaded images. An
+    /// image larger than the whole budget is uploaded for its draw and not
+    /// kept.
+    pub fn new_caching(budget: usize) -> Self {
+        // SAFETY: `C_ImageProvider_MakeCaching` never returns null: it is a
+        // plain `new`, which aborts rather than returning null.
+        ImageProvider::from_ptr(unsafe { sb::C_ImageProvider_MakeCaching(budget) }).unwrap()
+    }
+
+    /// Drops every kept image. The provider keeps working, and uploads again
+    /// what it is next asked for.
+    pub fn purge(&self) {
+        unsafe { sb::C_ImageProvider_purge(self.native_mut_force()) }
+    }
+
+    /// How many bytes of uploaded images the provider keeps now.
+    pub fn kept_bytes(&self) -> usize {
+        unsafe { sb::C_ImageProvider_keptBytes(self.native()) }
+    }
+}
