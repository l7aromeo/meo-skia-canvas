FROM node:26-alpine3.23 AS skia-build-env
ARG TARGETARCH

ENV RUSTFLAGS="-C target-feature=-crt-static" \
    CC="clang" \
    CXX="clang++" \
    GN_EXE="gn" \
    SKIA_GN_COMMAND="/usr/bin/gn" \
    SKIA_NINJA_COMMAND="/usr/bin/ninja"

RUN apk update && apk add --update --no-cache \
    bash curl git git-lfs python3 perl build-base g++ linux-headers ttf-dejavu \
    musl-dev openssl-dev gn ninja-build nasm

# nasm comes from the line above, not this one, and that is also what holds the base image at
# Alpine 3.23.
#
# libaom's `test_nasm` compares no versions. It runs `nasm -hf` and searches the help text for the
# literal `-Ox`; nasm 3.x moved that line under `-hO`, so the search finds nothing and configure
# dies with "Unsupported nasm: multipass optimization not supported" while the option itself still
# works. libaom changed the flag to `-hO` in 3.13.2, but `libaom-sys` is at 0.17.2+libaom.3.11.0,
# the newest release on crates.io, so the fix is not reachable from here.
#
# 2.16.03 still prints `-Ox` under `-hf`, which is why the assembler comes from the base repo
# rather than edge. Alpine's main repo carries 2.16.03 through 3.23 and 3.01 from 3.24 on, so a
# base image past 3.23 fails this configure step until `libaom-sys` ships libaom 3.13.2 or later.
# Re-check: `docker run --rm alpine:<version> sh -c 'apk add -q nasm && nasm -hf | grep -F -- -Ox'`
# against the base image you want, and the `libaom-sys` version in Cargo.lock.
RUN apk add --update --no-cache --repository http://dl-cdn.alpinelinux.org/alpine/edge/main \
    gperf cmake expat-static expat-dev libpng-dev \
    clang clang-dev llvm llvm-dev libc++ libc++-dev

# Point clang at a GCC installation that is actually complete.
#
# Two things went wrong here, and the second was hiding behind the first.
#
# clang locates a GCC installation by matching the *target triple*. `libaom-sys` drives cmake with
# `--target=<arch>-unknown-linux-musl`, the Rust triple, while Alpine installs gcc under
# `<arch>-alpine-linux-musl`. No match, so clang found no GCC at all and the link died before
# anything of ours compiled:
#
#   /usr/bin/ld: cannot find crtbeginS.o: No such file or directory
#   /usr/bin/ld: cannot find -lgcc: No such file or directory
#
# Underneath that, two GCC installations coexist: 13.2.1 from the base repo, complete with headers
# under /usr/include/c++/13.2.1, and a 15.2.0 directory that edge's `libgcc-static` leaves behind
# with no headers at all. clang prefers the higher version, computes its C++ include path from it,
# and finds nothing -- so C++ failed with "'cstdint' file not found" under *either* triple, which
# is how a release got as far as compiling libaom's ratectrl_rtc.cc before falling over.
#
# Pinning --gcc-install-dir answers both: it names a directory, so no triple has to match, and it
# names the complete one, so the headers are where clang then looks. The directory is chosen by
# what it contains rather than by version, because "newest" is precisely the wrong answer here.
#
# The config file goes beside the clang binary. The glibc image puts one in /etc/clang, which this
# clang does not read -- checked, along with /etc/clang22, which it does.
RUN ARCH="$(uname -m)" && ALPINE_TRIPLE="${ARCH}-alpine-linux-musl" && \
    GCC_DIR="" && \
    for dir in /usr/lib/gcc/"$ALPINE_TRIPLE"/*/; do \
      version="$(basename "$dir")"; \
      if [ -f "${dir}crtbeginS.o" ] && [ -d "/usr/include/c++/${version}/${ALPINE_TRIPLE}" ]; then \
        GCC_DIR="${dir%/}"; \
      fi; \
    done && \
    test -n "$GCC_DIR" && \
    CLANG_DIR="$(dirname "$(readlink -f "$(which clang)")")" && \
    printf -- '--gcc-install-dir=%s\n' "$GCC_DIR" \
      | tee "$CLANG_DIR/clang++.cfg" > "$CLANG_DIR/clang.cfg" && \
    printf 'int main(){ return 0; }\n' > /tmp/triple.c && \
    printf '#include <cstdint>\n#include <vector>\nint main(){ std::vector<int> v; return (int)v.size(); }\n' > /tmp/triple.cc && \
    clang --target="${ARCH}-unknown-linux-musl" /tmp/triple.c -o /tmp/triple && \
    clang++ --target="${ARCH}-unknown-linux-musl" /tmp/triple.cc -o /tmp/triplexx && \
    rm -f /tmp/triple.c /tmp/triple.cc /tmp/triple /tmp/triplexx && \
    echo "clang compiles and links C and C++ under the rust triple: ok"

# manually build freetype & fontconfig and install fontconfig in /usr/local
COPY ./install-fontlibs.sh /opt
COPY ./freetype.cfg /opt
RUN bash /opt/install-fontlibs.sh

# move static fontconfig to a common location (freetype BDF stubs are in skia-canvas)
RUN mkdir -p /opt/skia-static-libs && \
    cp /usr/local/lib/libfontconfig.a /opt/skia-static-libs

# install gh
ARG GH_VERSION=2.86.0
ARG GH_URL=https://github.com/cli/cli/releases/download/v$GH_VERSION/gh_${GH_VERSION}_linux_$TARGETARCH.tar.gz
RUN curl -sfL --retry 3 $GH_URL | tar xz --strip-components=2 -C /usr/local/bin

WORKDIR /opt
CMD ["bash"]
