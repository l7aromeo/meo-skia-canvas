  "customFooterHtml": "<nav class=\"msc-footer-links\"><a href=\"https://github.com/l7aromeo/meo-skia-canvas\">Source</a><a href=\"https://www.npmjs.com/package/meo-skia-canvas\">npm</a><a href=\"https://docs.rs/meo-skia-canvas\">Rust reference</a></nav>",
